<!-- compose:widget offerings/credentials-block -->
<% function _accent(txt){ if(!txt) return ''; var _e=String(txt).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); return _e.replace(/\{([^}]+)\}/g, '<em style="font-style:italic;color:var(--color-primary);font-weight:inherit;">$1</em>'); } %>
<% var _creds = (typeof items !== 'undefined' && items) ? items : (typeof credentials !== 'undefined' ? credentials : []); %>
<% var _license = (typeof license_text !== 'undefined' && license_text) ? license_text : ''; %>
<%
  // Content-integrity rule: credentials are claims about the business
  // (licenses, certifications, professional standing). Render nothing
  // when neither license_text nor any credentials items are present so
  // we never ship an empty bordered card chrome that implies the customer
  // has credentials when they have not entered any.
%>
<% if (_license || _creds.length > 0) { %>
<section class="py-10 md:py-14" style="background-color: var(--color-surface);">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <% if (typeof heading !== 'undefined' && heading) { %>
      <div class="text-center mb-8">
        <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
          <div class="font-body text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-foreground-muted);"><%= eyebrow %></div>
        <% } %>
        <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight" style="color: var(--color-foreground);"><%- _accent(heading) %></h2>
      </div>
    <% } %>
    <div class="p-6 md:p-8 rounded-xl border" style="background-color: var(--color-background); border-color: var(--color-border);">
      <% if (_license) { %>
        <div class="<%= _creds.length > 0 ? 'mb-6 pb-6 border-b' : '' %>" style="border-color: var(--color-border);">
          <div class="font-body text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-foreground-muted);">License</div>
          <div class="font-body text-base" style="color: var(--color-foreground);"><%= _license %></div>
        </div>
      <% } %>
      <% if (_creds.length > 0) { %>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% _creds.forEach(function(c) { %>
            <div>
              <dt class="font-body text-xs font-bold uppercase tracking-widest mb-1" style="color: var(--color-foreground-muted);"><%= c.label || c.type %></dt>
              <dd class="font-body text-sm" style="color: var(--color-foreground);"><%= c.value %><% if (c.sub) { %><br><span style="color: var(--color-foreground-muted);"><%= c.sub %></span><% } %></dd>
            </div>
          <% }); %>
        </dl>
      <% } %>
    </div>
  </div>
</section>
<% } %>
