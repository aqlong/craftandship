<!-- compose:widget offerings/services-editorial-table -->
<%
function _accent(txt){ if(!txt) return ''; var _e=String(txt).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); return _e.replace(/\{([^}]+)\}/g, '<em style="font-style:italic;color:var(--color-primary);font-weight:inherit;">$1</em>'); }
var _items = (typeof items !== 'undefined' && items) ? items : [];
%>
<% if (_items.length > 0) { %>
<section class="py-10 md:py-14" style="background-color: var(--color-background);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <% if (typeof heading !== 'undefined' && heading) { %>
      <div class="mb-10">
        <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
          <div class="font-body text-xs font-bold uppercase mb-3" style="color: var(--color-foreground-muted); letter-spacing: 0.15em;"><%= eyebrow %></div>
        <% } %>
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight" style="color: var(--color-foreground); letter-spacing: -0.02em;"><%- _accent(heading) %></h2>
      </div>
    <% } %>
    <ul class="cas-services-table" style="list-style: none; padding: 0; margin: 0;">
      <% _items.forEach(function(item, idx) { %>
        <% var _itemImg = item.image_url || item.photo_url || item.cover_url || ''; %>
        <li class="flex items-start gap-4 py-5" style="border-top: 1px solid var(--color-border); <%= idx === _items.length - 1 ? 'border-bottom: 1px solid var(--color-border);' : '' %>">
          <% if (_itemImg) { %>
            <div class="flex-shrink-0" style="width: 64px; height: 64px;">
              <img loading="lazy" src="<%= _itemImg %>" alt="<%= item.image_alt || item.title || '' %>" class="w-full h-full object-cover rounded-md" style="display: block;" />
            </div>
          <% } %>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-lg md:text-xl font-bold" style="color: var(--color-foreground); letter-spacing: -0.01em;"><%= item.title %></h3>
              <% if (item.price_display && item.price_display !== item.cta_text) { %>
                <div class="font-display text-base md:text-lg font-bold price" style="color: var(--color-primary); font-style: italic; letter-spacing: -0.01em;"><%= item.price_display %></div>
              <% } %>
            </div>
            <% if (item.description) { %>
              <p class="font-body text-sm leading-relaxed mt-2" style="color: var(--color-foreground-muted);"><%= item.description %></p>
            <% } %>
            <% if (item.cta_href && item.cta_text) { %>
              <div class="mt-3">
                <a href="<%= item.cta_href %>" class="inline-flex items-center font-body text-sm font-semibold transition-opacity hover:opacity-70" style="color: var(--color-primary); gap: 6px; text-decoration: none;">
                  <span><%= item.cta_text %></span>
                  <%- include('../utility/icon.ejs', { name: 'arrow-right', size: 14, stroke_width: 2 }) %>
                </a>
              </div>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  </div>
</section>
<% } %>
