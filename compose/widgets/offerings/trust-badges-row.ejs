<!-- compose:widget offerings/trust-badges-row -->
<% function _accent(txt){ if(!txt) return ''; var _e=String(txt).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); return _e.replace(/\{([^}]+)\}/g, '<em style="font-style:italic;color:var(--color-primary);font-weight:inherit;">$1</em>'); } %>
<% var _badges = (typeof items !== 'undefined' && items) ? items : (typeof badges !== 'undefined' ? badges : []); %>
<% if (_badges.length > 0) { %>
<section class="py-10 md:py-12" style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <% if (typeof heading !== 'undefined' && heading) { %>
      <div class="text-center mb-8">
        <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
          <div class="font-body text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-foreground-muted);"><%= eyebrow %></div>
        <% } %>
        <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight" style="color: var(--color-foreground);"><%- _accent(heading) %></h2>
      </div>
    <% } %>
    <!-- Editorial divided-row pattern: each badge is a horizontal row with
         a hairline divider, first badge gets emphasis, subsequent rows
         stay compact. Breaks the "4 equal cards" anti-pattern. -->
    <div class="max-w-3xl mx-auto">
      <% _badges.forEach(function(b, idx) { %>
        <div class="flex items-baseline justify-between gap-6 py-4 <%= idx < _badges.length - 1 ? 'border-b' : '' %>" style="border-color: var(--color-border);">
          <div class="flex-1">
            <div class="font-body text-sm font-semibold" style="color: var(--color-foreground);"><%= b.label %></div>
            <% if (b.sub) { %>
              <div class="font-body text-xs mt-1" style="color: var(--color-foreground-muted);"><%= b.sub %></div>
            <% } %>
          </div>
          <% if (b.number || b.label_top) { %>
            <div class="font-display <%= idx === 0 ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl' %> font-bold whitespace-nowrap" style="color: var(--color-primary);"><%= b.number || b.label_top %></div>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
