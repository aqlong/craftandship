<!-- compose:widget offerings/instructor-grid -->
<% function _accent(txt){ if(!txt) return ''; var _e=String(txt).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); return _e.replace(/\{([^}]+)\}/g, '<em style="font-style:italic;color:var(--color-primary);font-weight:inherit;">$1</em>'); } %>
<% var _instructors = (typeof items !== 'undefined' && items) ? items : (typeof rows !== 'undefined' ? rows : []); %>
<% var _detail_prefix = (typeof detail_path_prefix !== 'undefined') ? detail_path_prefix : null; %>
<% var _expand_inline = (typeof expand_inline !== 'undefined') ? expand_inline : false; %>
<%
  // Content-integrity rule: render nothing when there are no real
  // instructors. Prior version rendered the section chrome + heading +
  // an "Instructors coming soon." placeholder even when items was empty,
  // leaving an awkward band on fitness-home-default + fitness-home-
  // trust-first + fitness-home-editorial. The dedicated /instructors
  // page returns empty until the customer adds real team via
  // /admin/instructors.
%>
<% if (_instructors.length > 0) { %>
<style>
  .ig-card details.ig-reveal[open] .ig-hint-closed { display: none; }
  .ig-card details.ig-reveal .ig-hint-open { display: none; }
  .ig-card details.ig-reveal[open] .ig-hint-open { display: block; }
  .ig-card a.ig-link .ig-read-hint { opacity: 0; transition: opacity 0.2s ease; }
  .ig-card a.ig-link:hover .ig-read-hint { opacity: 1; }
  .ig-card a.ig-link:hover .ig-photo { transform: scale(1.04); }
  .ig-card .ig-photo { transition: transform 0.2s ease; }
</style>
<section class="py-10 md:py-14 ig-card" style="background-color: var(--color-background);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <% if (typeof heading !== 'undefined' && heading) { %>
      <div class="text-center mb-10">
        <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
          <div class="font-body text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--color-foreground-muted);"><%= eyebrow %></div>
        <% } %>
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight" style="color: var(--color-foreground);"><%- _accent(heading) %></h2>
      </div>
    <% } %>
      <div class="cas-card-grid-4">
        <% _instructors.forEach(function(person) { %>
          <% var _useLink = _detail_prefix && person.id; %>
          <% var _useInline = !_useLink && _expand_inline && person.bio; %>
          <% var _spec = person.specialties; if (typeof _spec === 'string') { try { _spec = JSON.parse(_spec); } catch(e) { _spec = _spec.split(',').map(function(s){return s.trim();}); } } _spec = _spec || []; %>
          <% if (_useLink) { %>
            <a href="<%= _detail_prefix %>/<%= person.id %>" class="text-center block ig-link" style="color: inherit; text-decoration: none;">
              <% if (person.photo_url || person.image_url) { %>
                <div style="aspect-ratio: 1/1; overflow: hidden; border-radius: 9999px; background-color: var(--color-surface);" class="mb-3 mx-auto ig-photo">
                  <img src="<%= person.photo_url || person.image_url %>" alt="<%= person.name %>" class="w-full h-full object-cover" loading="lazy" />
                </div>
              <% } %>
              <h3 class="font-display text-base font-bold" style="color: var(--color-foreground);"><%= person.name %></h3>
              <% if (person.role || person.title) { %>
                <div class="font-body text-xs font-bold uppercase tracking-widest mt-1" style="color: var(--color-primary);"><%= person.role || person.title %></div>
              <% } %>
              <% if (_spec.length > 0) { %>
                <p class="font-body text-xs mt-1" style="color: var(--color-foreground-muted);"><%= _spec.slice(0,3).join(' · ') %></p>
              <% } %>
              <div class="font-body text-xs mt-2 ig-read-hint" style="color: var(--color-primary);">Read bio →</div>
            </a>
          <% } else if (_useInline) { %>
            <details class="text-center ig-reveal">
              <summary class="list-none cursor-pointer" style="list-style: none;">
                <% if (person.photo_url || person.image_url) { %>
                  <div style="aspect-ratio: 1/1; overflow: hidden; border-radius: 9999px; background-color: var(--color-surface);" class="mb-3 mx-auto">
                    <img src="<%= person.photo_url || person.image_url %>" alt="<%= person.name %>" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                <% } %>
                <h3 class="font-display text-base font-bold" style="color: var(--color-foreground);"><%= person.name %></h3>
                <% if (person.role || person.title) { %>
                  <div class="font-body text-xs font-bold uppercase tracking-widest mt-1" style="color: var(--color-primary);"><%= person.role || person.title %></div>
                <% } %>
                <% if (_spec.length > 0) { %>
                  <p class="font-body text-xs mt-1" style="color: var(--color-foreground-muted);"><%= _spec.slice(0,3).join(' · ') %></p>
                <% } %>
                <div class="font-body text-xs mt-2 ig-hint-closed" style="color: var(--color-primary);">+ Read more</div>
                <div class="font-body text-xs mt-2 ig-hint-open" style="color: var(--color-primary);">− Hide</div>
              </summary>
              <div class="mt-4 text-left font-body text-sm leading-relaxed whitespace-pre-wrap" style="color: var(--color-foreground);"><%= person.bio %></div>
              <% if (person.instagram_url) { %>
                <div class="mt-3 text-left"><a href="<%= person.instagram_url %>" target="_blank" rel="noopener" class="font-body text-xs" style="color: var(--color-primary);">Instagram ↗</a></div>
              <% } %>
            </details>
          <% } else { %>
            <div class="text-center">
              <% if (person.photo_url || person.image_url) { %>
                <div style="aspect-ratio: 1/1; overflow: hidden; border-radius: 9999px; background-color: var(--color-surface);" class="mb-3 mx-auto">
                  <img src="<%= person.photo_url || person.image_url %>" alt="<%= person.name %>" class="w-full h-full object-cover" loading="lazy" />
                </div>
              <% } %>
              <h3 class="font-display text-base font-bold" style="color: var(--color-foreground);"><%= person.name %></h3>
              <% if (person.role || person.title) { %>
                <div class="font-body text-xs font-bold uppercase tracking-widest mt-1" style="color: var(--color-primary);"><%= person.role || person.title %></div>
              <% } %>
              <% if (_spec.length > 0) { %>
                <p class="font-body text-xs mt-1" style="color: var(--color-foreground-muted);"><%= _spec.slice(0,3).join(' · ') %></p>
              <% } %>
            </div>
          <% } %>
        <% }); %>
      </div>
  </div>
</section>
<% } %>
