<!-- compose:widget shell/nav-side-rail -->
<%
   // Directory-rich nav: persistent left rail on lg+ that anchors the
   // site visually. Information-dense businesses (HVAC, multi-location
   // local services, salons with many staff) have more places to go;
   // a side rail keeps the structure visible at all times rather than
   // hiding it behind a hamburger or top-bar overflow.
   //
   // Differences from nav-public:
   //   - On lg+ (>=1024px): fixed left rail 240px wide with vertical
   //     nav links + small contact block at bottom. Main content
   //     pushes right via padding on body or main element.
   //   - On sm/md: collapses to a sticky thin top bar (similar to
   //     nav-public but lighter weight) plus a hamburger.
   //   - Logo monogram visible at top of rail; persistent across
   //     scroll. CTA pinned at bottom of rail (login or admin link).
   //   - Same data contract as nav-public.
   //
   // The 240px left padding for main content is applied via the body
   // class `.cas-template-directory-rich` rule emitted by the layout
   // file, not by this nav itself, so widgets remain layout-agnostic.
   var _cp = (typeof currentPath !== 'undefined' ? currentPath : (typeof locals !== 'undefined' && locals.currentPath) || '/');
   var _user = (typeof user !== 'undefined' && user) ? user : (typeof locals !== 'undefined' ? locals.user : null);
   var _isAdmin = !!(_user && _user.role === 'admin');
   var _logoUrl = settings.nav_logo_url || '';
   // wsimg.com is the GoDaddy Website Builder CDN; default-globe logo path.
   // See nav-public.ejs for the same carve-out.
   var _isPlaceholderLogo = /picsum|placeholder|loremflickr|via\.placeholder|lorempixel|wsimg\.com.*\/logo\//i.test(_logoUrl) || !_logoUrl;
   var _initials = String(settings.site_name || '').split(/\s+/).filter(Boolean).slice(0, 2).map(function(w){return w[0].toUpperCase();}).join('');
%>
<!-- Side rail (lg+) -->
<aside class="cas-side-rail hidden lg:flex" style="position: fixed; top: 0; left: 0; bottom: 0; width: 240px; background-color: var(--color-surface); border-right: 1px solid var(--color-border); flex-direction: column; padding: 1.5rem 1.25rem; z-index: 50; overflow-y: auto;">
  <a href="/" class="font-display" style="display: flex; align-items: center; gap: 0.75rem; color: var(--color-foreground); text-decoration: none; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.25rem;">
    <span style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 9999px; background-color: var(--color-primary); color: var(--color-on-primary); font-weight: 700; font-size: 13px; letter-spacing: 0.03em;">
      <% if (_isPlaceholderLogo) { %><%= _initials || '·' %><% } else { %><img src="<%= _logoUrl %>" alt="<%= settings.site_name %>" style="width: 100%; height: 100%; object-fit: cover; border-radius: 9999px;" /><% } %>
    </span>
    <span style="font-weight: 600; font-size: 1rem; letter-spacing: -0.01em;"><%= settings.site_name %></span>
  </a>
  <nav style="display: flex; flex-direction: column; gap: 0.125rem; flex: 1;">
    <% (typeof nav_items !== 'undefined' ? nav_items : []).forEach(function(item) { %>
      <% var isActive = (item.href === '/' ? _cp === '/' : _cp.indexOf(item.href) === 0); %>
      <a href="<%= item.href %>" class="font-body" style="display: block; padding: 0.625rem 0.75rem; border-radius: 6px; color: var(--color-foreground); text-decoration: none; font-size: 0.875rem; font-weight: 500; <% if (isActive) { %>background-color: var(--color-primary); color: var(--color-on-primary);<% } else { %>opacity: 0.85;<% } %>"><%= item.label %></a>
    <% }); %>
  </nav>
  <div style="border-top: 1px solid var(--color-border); padding-top: 1rem; margin-top: 1rem;">
    <% if (settings.contact_phone) { %>
      <a href="tel:<%= settings.contact_phone.replace(/[^0-9+]/g, '') %>" class="font-body" style="display: block; color: var(--color-primary); font-size: 0.875rem; font-weight: 600; text-decoration: none; margin-bottom: 0.5rem;"><%= settings.contact_phone %></a>
    <% } %>
    <% if (_isAdmin) { %>
      <a href="/admin" class="font-body" style="display: block; padding: 0.5rem 0; color: var(--color-foreground-muted); font-size: 0.75rem; text-decoration: none; text-transform: uppercase; letter-spacing: 0.12em;">Admin Dashboard</a>
      <form action="/logout" method="POST" style="margin: 0;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="font-body" style="background: transparent; border: 0; cursor: pointer; padding: 0.5rem 0; color: var(--color-foreground-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em;">Logout</button>
      </form>
    <% } else { %>
      <a href="/login" class="font-body" style="display: inline-block; padding: 0.5rem 0.875rem; background-color: var(--color-primary); color: var(--color-on-primary); border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em;">Login</a>
    <% } %>
  </div>
</aside>
<!-- Top bar (sm/md only) -->
<nav class="lg:hidden" style="background-color: var(--color-primary); position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--color-border);">
  <div style="display: flex; align-items: center; justify-content: space-between; padding: 0 1rem; height: 56px;">
    <a href="/" class="font-display" style="color: var(--color-on-primary); text-decoration: none; font-weight: 700; font-size: 1rem;"><%= settings.site_name %></a>
    <button id="mobileMenuBtn" class="p-2 min-h-[44px] min-w-[44px]" style="background: transparent; border: 0; color: var(--color-on-primary); cursor: pointer;" aria-label="Toggle menu" aria-expanded="false">
      <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <div id="mobileMenu" class="hidden" style="background-color: var(--color-primary); padding: 0.5rem 1rem 1rem;">
    <% (typeof nav_items !== 'undefined' ? nav_items : []).forEach(function(item) { %>
      <% var isActive = (item.href === '/' ? _cp === '/' : _cp.indexOf(item.href) === 0); %>
      <a href="<%= item.href %>" class="font-body" style="display: block; padding: 0.625rem 0; color: var(--color-on-primary); text-decoration: none; font-size: 0.875rem; font-weight: 500; opacity: <%= isActive ? '1' : '0.85' %>;"><%= item.label %></a>
    <% }); %>
    <% if (_isAdmin) { %>
      <a href="/admin" class="font-body" style="display: block; padding: 0.625rem 0; color: var(--color-on-primary); text-decoration: none; font-size: 0.875rem; opacity: 0.85;">Admin</a>
    <% } else { %>
      <a href="/login" class="font-body" style="display: inline-block; margin-top: 0.5rem; padding: 0.5rem 1rem; background-color: var(--color-on-primary); color: var(--color-primary); border-radius: 4px; font-size: 0.875rem; font-weight: 600; text-decoration: none;">Login</a>
    <% } %>
  </div>
</nav>
<script<% if (typeof cspNonce !== 'undefined' && cspNonce) { %> nonce="<%= cspNonce %>"<% } %>>
  (function(){
    var btn = document.getElementById('mobileMenuBtn');
    var menu = document.getElementById('mobileMenu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function(){
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
