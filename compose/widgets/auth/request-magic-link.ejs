<!-- compose:widget auth/request-magic-link; letterpress-shell form to request
     a magic-link login. POST handler in routes/auth.js generates a token,
     attempts to email it (no-op when SMTP unconfigured), and ALWAYS
     redirects to /magic-link-sent (anti-enumeration). -->
<%
var _site = (typeof settings !== 'undefined' && settings) ? settings : {};
var _err = locals.error;
var _err_html = _err
  ? ('<div class="cas-auth-letterpress__notice cas-auth-letterpress__notice--error" role="alert">' +
       String(_err).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') +
     '</div>')
  : '';
var _bodyHtml =
  _err_html +
  '<form action="/request-magic-link" method="POST" class="cas-auth-letterpress__form cas-form" novalidate>' +
    '<input type="hidden" name="_csrf" value="' + String(csrfToken).replace(/[^A-Za-z0-9_-]/g, '') + '">' +
    '<label class="cas-auth-letterpress__field">' +
      '<span class="cas-auth-letterpress__label">Email</span>' +
      '<input class="cas-auth-letterpress__input" type="email" name="email" required autocomplete="email" autofocus />' +
    '</label>' +
    '<button type="submit" class="cas-auth-letterpress__submit">Send me a link</button>' +
  '</form>';
var _footerHtml = '<p class="cas-auth-letterpress__foot-line"><a href="/login">Back to sign in</a></p>';
%>
<%- include('widgets/auth/letterpress', {
  siteName: _site.site_name || 'Site',
  brandHref: '/',
  eyebrow: 'Login link',
  formHeading: 'Request a login link',
  formSubheading: 'We will email you a one-time link that signs you in.',
  bodyHtml: _bodyHtml,
  footerHtml: _footerHtml,
}) %>
