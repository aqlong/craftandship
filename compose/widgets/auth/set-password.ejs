<!-- compose:widget auth/set-password; password set form.
     Reached after /magic/consume redirects when password_set=FALSE, and
     directly by a signed-in user. Uses the letterpress shell. The route
     passes needs_current=true when the POST handler in routes/auth.js will
     require the current password (the account already has one and this
     session was not just started by a login link); the form then shows
     that field. The handler hashes + stores the password, marks
     password_set=TRUE, redirects to /admin. -->
<%
var _site = (typeof settings !== 'undefined' && settings) ? settings : {};
var _err = locals.error;
var _needsCurrent = !!locals.needs_current;
var _err_html = _err
  ? ('<div class="cas-auth-letterpress__notice cas-auth-letterpress__notice--error" role="alert">' +
       String(_err).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') +
     '</div>')
  : '';
var _bodyHtml =
  _err_html +
  '<form action="/set-password" method="POST" class="cas-auth-letterpress__form cas-form" novalidate>' +
    '<input type="hidden" name="_csrf" value="' + String(csrfToken).replace(/[^A-Za-z0-9_-]/g, '') + '">' +
    (_needsCurrent
      ? ('<label class="cas-auth-letterpress__field">' +
           '<span class="cas-auth-letterpress__label">Current password</span>' +
           '<input class="cas-auth-letterpress__input" type="password" name="current_password" required autocomplete="current-password" autofocus />' +
           '<span class="cas-auth-letterpress__hint">Forgot it? Sign out, request a login link, and come back here within 15 minutes of using it.</span>' +
         '</label>')
      : '') +
    '<label class="cas-auth-letterpress__field">' +
      '<span class="cas-auth-letterpress__label">New password</span>' +
      '<input class="cas-auth-letterpress__input" type="password" name="new_password" required minlength="8" autocomplete="new-password"' + (_needsCurrent ? '' : ' autofocus') + ' />' +
      '<span class="cas-auth-letterpress__hint">At least 8 characters.</span>' +
    '</label>' +
    '<label class="cas-auth-letterpress__field">' +
      '<span class="cas-auth-letterpress__label">Confirm password</span>' +
      '<input class="cas-auth-letterpress__input" type="password" name="confirm_password" required minlength="8" autocomplete="new-password" />' +
    '</label>' +
    '<button type="submit" class="cas-auth-letterpress__submit">Set password</button>' +
  '</form>';
%>
<%- include('widgets/auth/letterpress', {
  siteName: _site.site_name || 'Site',
  brandHref: '/',
  eyebrow: 'Set password',
  formHeading: 'Set your password',
  formSubheading: 'Pick a password so you can sign in directly next time.',
  bodyHtml: _bodyHtml,
}) %>
