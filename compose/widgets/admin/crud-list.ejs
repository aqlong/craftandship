<!-- compose:widget admin/crud-list -->
<% function _isImageUrl(v){ if(!v||typeof v!=='string')return false; return /^(https?:\/\/|\/uploads\/)/.test(v) && /(image|photo|picsum|\.(jpe?g|png|gif|webp|svg))/i.test(v); } %>
<% function _displayLabel(col){ if(col.key==='image_url'||col.key==='photo_url'||col.key==='logo_url'||col.key==='avatar_url')return 'Image'; return col.label; } %>
<% function _fmtTime(t){ if(!t)return ''; var p=String(t).split(':'); var h=parseInt(p[0]||0,10); var m=p[1]||'00'; var ap=h>=12?'PM':'AM'; var hh=h%12||12; return hh+':'+m+' '+ap; } %>
<% var _pg = (typeof pagination !== 'undefined' && pagination) ? pagination : null; %>
<% function _sortHref(colKey){
  if (!_pg) return '#';
  var base = _pg.base_path || '/admin/' + resource_slug;
  var qs = ['per_page=' + _pg.per_page];
  var nextOrder = 'asc';
  if (_pg.sort === colKey && _pg.order === 'asc') nextOrder = 'desc';
  qs.push('sort=' + encodeURIComponent(colKey));
  qs.push('order=' + nextOrder);
  return base + '?' + qs.join('&');
} %>
<% function _pageHref(n){
  if (!_pg) return '#';
  var base = _pg.base_path || '/admin/' + resource_slug;
  var qs = ['page=' + n, 'per_page=' + _pg.per_page];
  if (_pg.sort) { qs.push('sort=' + encodeURIComponent(_pg.sort)); qs.push('order=' + _pg.order); }
  return base + '?' + qs.join('&');
} %>
<section class="py-10" style="background-color: var(--color-surface); min-height: calc(100vh - 64px);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-display text-3xl font-bold" style="color: var(--color-foreground);">Manage <%= resource_name_plural %></h1>
        <p class="font-body text-sm mt-1" style="color: var(--color-foreground-muted);">
          <% if (_pg) { %>
            <%= _pg.total %> total
            <% if (_pg.total > _pg.per_page) { %>
              · showing <%= ((_pg.page - 1) * _pg.per_page) + 1 %>–<%= Math.min(_pg.page * _pg.per_page, _pg.total) %>
            <% } %>
          <% } else { %>
            <%= rows.length %> total
          <% } %>
        </p>
      </div>
      <a href="/admin/<%= resource_slug %>/new" class="inline-flex items-center font-body font-medium px-5 py-2 rounded-md transition-opacity hover:opacity-90 min-h-[44px]" style="background-color: var(--color-primary); color: var(--color-on-primary);">Add New</a>
    </div>
    <% if (locals.flashSuccess) { %>
      <div class="mb-4 bg-green-50 text-green-800 border border-green-200 rounded-lg px-4 py-3 text-sm" role="alert"><%= flashSuccess %></div>
    <% } %>
    <% if (locals.flashError) { %>
      <div class="mb-4 bg-red-50 text-red-800 border border-red-200 rounded-lg px-4 py-3 text-sm" role="alert"><%= flashError %></div>
    <% } %>
    <% if (rows.length === 0) { %>
      <div class="p-12 rounded-xl border text-center" style="background: white; border-color: var(--color-border);">
        <p class="font-body" style="color: var(--color-foreground-muted);">No <%= resource_name_plural.toLowerCase() %> yet. Click "Add New" to create one.</p>
      </div>
    <% } else { %>
      <div class="rounded-xl border overflow-hidden" style="background: white; border-color: var(--color-border);">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b" style="background-color: var(--color-surface); border-color: var(--color-border);">
                <% columns.forEach(function(col) { %>
                  <% var _isSorted = _pg && _pg.sort === col.key; %>
                  <% var _arrow = _isSorted ? (_pg.order === 'asc' ? '↑' : '↓') : '⇅'; %>
                  <% var _arrowOpacity = _isSorted ? '1' : '0.4'; %>
                  <th class="font-body text-xs font-bold uppercase tracking-widest text-left py-3 px-4 cas-sortable-th" style="color: var(--color-foreground-muted);">
                    <% if (_pg) { %>
                      <a href="<%= _sortHref(col.key) %>" class="cas-sort-link no-underline" style="color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; <% if (_isSorted) { %>color: var(--color-primary);<% } %>" title="Sort by <%= _displayLabel(col) %>">
                        <span><%= _displayLabel(col) %></span>
                        <span class="cas-sort-arrow" style="font-size: 11px; opacity: <%= _arrowOpacity %>; font-weight: 400;"><%= _arrow %></span>
                      </a>
                    <% } else { %>
                      <%= _displayLabel(col) %>
                    <% } %>
                  </th>
                <% }); %>
                <th class="font-body text-xs font-bold uppercase tracking-widest text-right py-3 px-4" style="color: var(--color-foreground-muted); width: 1%; white-space: nowrap;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function(row) { %>
                <tr class="border-b last:border-b-0" style="border-color: var(--color-border);">
                  <% columns.forEach(function(col) { %>
                    <td class="py-3 px-4 font-body" style="color: var(--color-foreground); vertical-align: middle;">
                      <% var val = row[col.key]; %>
                      <% if (val === null || val === undefined || val === '') { %>
                        <span style="color: var(--color-foreground-muted);">-</span>
                      <% } else if (_isImageUrl(val)) { %>
                        <img src="<%= val %>" alt="" loading="lazy" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; border: 1px solid var(--color-border); background: var(--color-surface);" />
                      <% } else if (col.key === 'event_time' || col.key === 'end_time' || col.key === 'start_time') { %>
                        <%= _fmtTime(val) %>
                      <% } else if (val instanceof Date || (typeof val === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(val))) { %>
                        <time class="cas-fmt-datetime-compact" datetime="<%= val instanceof Date ? val.toISOString() : val %>"><%= val %></time>
                      <% } else if (val instanceof Date || (typeof val === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(val))) { %>
                        <time class="cas-fmt-date" datetime="<%= val %>"><%= val %></time>
                      <% } else if (typeof val === 'boolean') { %>
                        <% if (val) { %>
                          <span style="color: var(--color-success); display: inline-flex; align-items: center;" title="Yes"><%- include('../utility/icon.ejs', { name: 'check', size: 16, stroke_width: 2.25 }) %></span>
                        <% } else { %>
                          <span style="color: var(--color-foreground-muted); display: inline-flex; align-items: center;" title="No"><%- include('../utility/icon.ejs', { name: 'x', size: 16, stroke_width: 2 }) %></span>
                        <% } %>
                      <% } else if (typeof val === 'string' && val.length > 80) { %>
                        <%= val.substring(0, 80) %>…
                      <% } else { %>
                        <%= val %>
                      <% } %>
                    </td>
                  <% }); %>
                  <td class="py-3 px-4 text-right font-body text-sm" style="white-space: nowrap; vertical-align: middle;">
                    <div class="inline-flex items-center gap-1 rounded-md border overflow-hidden" style="border-color: var(--color-border); background: white;">
                      <a href="/admin/<%= resource_slug %>/<%= row.id %>" class="font-body text-xs font-medium px-3 py-2 transition-colors no-underline" style="color: var(--color-foreground-muted); text-decoration: none;">View</a>
                      <span style="width:1px;height:18px;background:var(--color-border);"></span>
                      <a href="/admin/<%= resource_slug %>/<%= row.id %>/edit" class="font-body text-xs font-medium px-3 py-2 transition-colors no-underline" style="color: var(--color-primary); text-decoration: none;">Edit</a>
                      <span style="width:1px;height:18px;background:var(--color-border);"></span>
                      <form action="/admin/<%= resource_slug %>/<%= row.id %>/delete" method="POST" style="display:inline-flex" data-confirm="Delete this <%= resource_name_plural.toLowerCase().replace(/s$/,'') %>?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="bg-transparent border-0 cursor-pointer font-body text-xs font-medium px-3 py-2 transition-opacity hover:opacity-70" style="color: var(--color-error);">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
      <% if (_pg && _pg.total_pages > 1) { %>
        <div class="flex items-center justify-between mt-4" style="gap: 12px; flex-wrap: wrap;">
          <div class="font-body text-sm" style="color: var(--color-foreground-muted);">Page <%= _pg.page %> of <%= _pg.total_pages %></div>
          <nav class="inline-flex items-center gap-1 rounded-md border overflow-hidden" style="border-color: var(--color-border); background: white;">
            <% if (_pg.has_prev) { %>
              <a href="<%= _pageHref(_pg.page - 1) %>" class="font-body text-xs font-medium px-3 py-2 no-underline" style="color: var(--color-foreground); text-decoration: none;">← Prev</a>
            <% } else { %>
              <span class="font-body text-xs font-medium px-3 py-2" style="color: var(--color-foreground-muted); opacity: 0.5;">← Prev</span>
            <% } %>
            <span style="width:1px;height:18px;background:var(--color-border);"></span>
            <%
              var _start = Math.max(1, _pg.page - 2);
              var _end = Math.min(_pg.total_pages, _start + 4);
              if (_end - _start < 4) _start = Math.max(1, _end - 4);
              for (var _i = _start; _i <= _end; _i++) {
            %>
              <a href="<%= _pageHref(_i) %>" class="font-body text-xs font-medium px-3 py-2 no-underline" style="<%= _i === _pg.page ? 'background-color: var(--color-primary); color: var(--color-on-primary);' : 'color: var(--color-foreground);' %> text-decoration: none;"><%= _i %></a>
              <% if (_i < _end) { %><span style="width:1px;height:18px;background:var(--color-border);"></span><% } %>
            <% } %>
            <span style="width:1px;height:18px;background:var(--color-border);"></span>
            <% if (_pg.has_next) { %>
              <a href="<%= _pageHref(_pg.page + 1) %>" class="font-body text-xs font-medium px-3 py-2 no-underline" style="color: var(--color-foreground); text-decoration: none;">Next →</a>
            <% } else { %>
              <span class="font-body text-xs font-medium px-3 py-2" style="color: var(--color-foreground-muted); opacity: 0.5;">Next →</span>
            <% } %>
          </nav>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
<script<% if (typeof cspNonce !== 'undefined' && cspNonce) { %> nonce="<%= cspNonce %>"<% } %>>
(function(){
  function fmtDate(el){var v=el.getAttribute('datetime')||el.textContent.trim();var d=new Date(v);if(isNaN(d.getTime()))return;el.textContent=d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});}
  function fmtDateTimeCompact(el){var v=el.getAttribute('datetime')||el.textContent.trim();var d=new Date(v);if(isNaN(d.getTime()))return;var date=d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});var time=d.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});el.textContent=date+' · '+time;}
  document.querySelectorAll('.cas-fmt-date').forEach(fmtDate);
  document.querySelectorAll('.cas-fmt-datetime-compact').forEach(fmtDateTimeCompact);
})();
</script>
