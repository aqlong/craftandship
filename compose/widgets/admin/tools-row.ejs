<!-- compose:widget admin/tools-row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
  <!-- Change Password -->
  <div class="p-6 rounded-xl border" style="background: white; border-color: var(--color-border);">
    <h3 class="font-display text-lg font-bold mb-1" style="color: var(--color-foreground);">Change Password</h3>
    <p class="font-body text-xs mb-4" style="color: var(--color-foreground-muted);">Set a password for future logins.</p>
    <form action="/admin/change-password" method="POST" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="cp-current" class="block font-body text-xs font-medium mb-1" style="color: var(--color-foreground);">Current Password</label>
        <input id="cp-current" type="password" name="current_password" placeholder="Leave blank if not set" class="w-full px-3 py-2 border rounded-md font-body text-sm" style="border-color: var(--color-border); background: white;" />
      </div>
      <div>
        <label for="cp-new" class="block font-body text-xs font-medium mb-1" style="color: var(--color-foreground);">New Password</label>
        <input id="cp-new" type="password" name="new_password" required minlength="8" placeholder="Minimum 8 characters" class="w-full px-3 py-2 border rounded-md font-body text-sm" style="border-color: var(--color-border); background: white;" />
      </div>
      <button type="submit" class="w-full font-body font-medium px-4 py-2 rounded-md transition-opacity hover:opacity-90" style="background-color: var(--color-primary); color: var(--color-on-primary);">Update Password</button>
    </form>
  </div>

  <!-- Site Settings shortcut -->
  <div class="p-6 rounded-xl border" style="background: white; border-color: var(--color-border);">
    <h3 class="font-display text-lg font-bold mb-1" style="color: var(--color-foreground);">Site Settings</h3>
    <p class="font-body text-xs mb-4" style="color: var(--color-foreground-muted);">Manage site name, hero, about, logo, contact info, and social links.</p>
    <a href="/admin/settings" class="inline-flex items-center justify-center w-full font-body font-medium px-4 py-2 rounded-md transition-opacity hover:opacity-90" style="background-color: var(--color-primary); color: var(--color-on-primary); text-decoration: none;">Open Settings</a>
  </div>

  <!-- Danger Zone -->
  <div class="p-6 rounded-xl border" style="background: white; border-color: #fecaca;">
    <h3 class="font-display text-lg font-bold mb-1" style="color: #991b1b;">Danger Zone</h3>
    <p class="font-body text-xs mb-4" style="color: var(--color-foreground-muted);">Clear all content data except user accounts. This action cannot be undone.</p>
    <form action="/admin/clear-all" method="POST" data-confirm="This will DELETE all content data (posts, events, photos, testimonials, inquiries, subscribers). User accounts are preserved. Continue?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="w-full font-body font-medium px-4 py-2 rounded-md" style="background-color: #dc2626; color: white; border: 0; cursor: pointer;">Clear All Data</button>
    </form>
  </div>
</div>
