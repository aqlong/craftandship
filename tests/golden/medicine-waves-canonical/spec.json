  "pages": [
    {
      "path": "/",
      "title": "Home",
      "purpose": "Hero with tagline and description, upcoming events preview cards, one featured video embed, CTA to events page",
      "allowed_roles": [
        "visitor",
        "admin"
      ],
      "auth_required": false
    },
    {
      "path": "/events",
      "title": "Events",
      "purpose": "Two sections: Upcoming Events (future dates ascending) and Past Events (past dates descending). Each event card shows title, date, location, image, and a Get Tickets button linking to rsvp_link. Event detail page shows full description, image, Posh ticket embed iframe (when posh_embed_url is set, height controlled by posh_embed_height), and RSVP link.",
      "allowed_roles": [
        "visitor",
        "admin"
      ],
      "auth_required": false
    },
    {
      "path": "/gallery",
      "title": "Gallery",
      "purpose": "Responsive photo grid showing all gallery photos with captions, ordered by display_order",
      "allowed_roles": [
        "visitor",
        "admin"
      ],
      "auth_required": false
    },
    {
      "path": "/videos",
      "title": "Videos",
      "purpose": "Video cards with title, description, and embedded YouTube player, ordered by display_order",
      "allowed_roles": [
        "visitor",
        "admin"
      ],
      "auth_required": false
    },
    {
      "path": "/about",
      "title": "About",
      "purpose": "Ocean's story, the dome description, and the Medicine Waves mission. All content reads from site_settings keys: about_title, about_body, about_photo_url. Photo displayed with text.",
      "allowed_roles": [
        "visitor",
        "admin"
      ],
      "auth_required": false
    },
    {
      "path": "/contact",
      "title": "Contact",
      "purpose": "Public page. Get In Touch block showing contact_email, contact_phone, contact_address from site_settings. Contact form with name, email, message fields. GET and POST both public, no login required. Form saves to contact_messages table.",
      "allowed_roles": [
        "visitor",
        "admin"
      ],
      "auth_required": false
    },
    {
      "path": "/admin",
      "title": "Admin Dashboard",
      "purpose": "Manage events (full CRUD), photos (full CRUD), videos (full CRUD), view contact messages (read-only), edit all site_settings keys including file uploads for nav_logo_url, hero_image_url, about_photo_url",
      "allowed_roles": [
        "admin"
      ],
      "auth_required": true
    }
  ],
