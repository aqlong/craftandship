<%# enum_select widget: renders a native <select> with one <option> per
    choice. {choices_ejs} is the EJS loop body generated by EnumWidget; we
    pre-expand it in Python so the template stays declarative. Uses
    `.input-premium` + `w-full` for consistent dark-theme styling. %>
<label for="{field_id}" class="block text-sm font-medium mb-1">{label}</label>
<select id="{field_id}" name="{field_name}" class="input-premium w-full"{required_attr}>
{choices_ejs}
</select>
