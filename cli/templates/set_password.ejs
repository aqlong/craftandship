<div class="min-h-[60vh] flex items-center justify-center">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-xl shadow-lg p-8">
      <h1 class="text-2xl font-bold mb-2 text-center">Set Your Password</h1>
      <p class="text-gray-600 mb-6 text-center">Choose a password for your account so you can log in directly next time.</p>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4"><%= error %></div>
      <% } %>
      <form action="/set-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-4">
          <label for="password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
          <input type="password" id="password" name="password" required minlength="8"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
            placeholder="At least 8 characters">
        </div>
        <div class="mb-6">
          <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary"
            placeholder="Type your password again">
        </div>
        <button type="submit" class="w-full bg-primary text-white py-2 px-4 rounded-lg hover:bg-primary/90 font-medium">
          Set Password
        </button>
      </form>
    </div>
  </div>
</div>
