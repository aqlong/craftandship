{
  "name": "craftandship-web",
  "version": "0.3.0",
  "description": "Craft & Ship customer-facing web application: Express, TypeScript, EJS, and PostgreSQL. Archived.",
  "private": true,
  "license": "MIT",
  "author": "Ocean Longnion",
  "repository": {
    "type": "git",
    "url": "https://github.com/aqlong/craftandship",
    "directory": "web"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch -r ts-node/register src/server.ts",
    "build": "npm run css:build && tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "css:build": "tailwindcss -i src/styles/input.css -o public/style.css --minify",
    "css:watch": "tailwindcss -i src/styles/input.css -o public/style.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@sentry/node": "^10.45.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "sharp": "^0.35.3",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "axe-core": "^4.11.4",
    "postcss": "^8.5.10",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "ip-address": "^10.1.1",
    "@parcel/watcher": "^2.6.0"
  }
}
