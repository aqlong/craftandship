# Craft & Ship web app: environment template.
#
# Copy to web/.env and edit. dotenv loads web/.env from the web/ working
# directory. Every variable the server reads is listed here; empty means unset,
# and the comment says what happens when it is unset. Secrets are left empty on
# purpose: never commit real values.

# ---------------------------------------------------------------------------
# 1. Core settings (only DATABASE_URL is required to boot in development)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The schema is applied automatically at boot
# (src/db/schema.sql via src/db/migrate.ts), so an empty database is enough.
# TLS: none for localhost (localhost, 127.0.0.1, ::1), Unix sockets and
# *.railway.internal; unless NODE_ENV is exactly development or test, any other
# host is reached over TLS WITHOUT certificate verification (an unset NODE_ENV
# and staging included); in development and test there is no TLS at all. For a
# verified connection append ?sslmode=verify-full (and &sslrootcert=/path/to/ca.pem
# for a private CA); an sslmode in the URL overrides those defaults. See
# src/db/index.ts and src/db/tls.ts.
DATABASE_URL=postgresql://cas:cas@localhost:5432/craftandship_web
# Standard libpq variable. Read only when DATABASE_URL names no host (for
# example postgresql:///name), to decide whether that connection needs TLS.
# Leave unset.
PGHOST=

# Signs session cookies, CSRF tokens, and unsubscribe tokens. Generate one
# with: openssl rand -hex 32
# The value below is a placeholder and is never used to sign anything. With
# NODE_ENV=development or test the server replaces it with a random secret for
# that process (development says so at boot), which means logins do not
# survive a restart until you set a real value. With any other NODE_ENV,
# including an unset one, the server refuses to start unless this is a real
# secret of at least 32 characters.
SESSION_SECRET=change-me-in-production

# HTTP port the server binds. If something already holds it, the server exits
# with a one-line message and a non-zero status. `npm run test:ui` reads the
# same variable (default 4000) for the server it starts and the pages it opens.
PORT=4000

# development | test | production.
# Only the exact values "development" and "test" count as a development
# environment. Anything else (production, a custom value such as "staging", or
# leaving this unset) gets the hardened behavior: Secure cookies, HSTS, no
# error text in responses, a real SESSION_SECRET required, and every
# development bypass below switched off whatever its flag says.
# Only Railway writes need exactly "production" (see CAS_ALLOW_RAILWAY_WRITES).
# "test" additionally raises or skips the request limiters and the trial-mint
# cap (the Haven cost caps are unchanged) so the test suite can run; never
# deploy with it.
NODE_ENV=development

# The one account that can open /admin/*. It must match the email of a
# registered, verified customer exactly; emails are stored lower-case, so write
# it in lower case. Also receives contact-form messages and Haven safety
# alerts. When unset, no one is admin and those emails are skipped; the contact
# form then tells the visitor the note could not be sent (see RESEND_API_KEY).
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# 2. Optional integrations (each degrades gracefully when unset)
# ---------------------------------------------------------------------------

# --- Anthropic ---
# Intake chat, spec extraction, support chat, and the Haven companion. Without
# it, greetings and the support chat fall back to canned text and the chat
# endpoints answer with an error; the rest of the site still renders.
ANTHROPIC_API_KEY=
# Ceiling on model calls per 24 hours made by the intake, revision, feature and
# support chats, the admin build analysis and the Harbor spec extraction
# together, across all users (Haven conversation turns have their own dollar
# caps below). In memory, per process. Default 3000; 0 stops those calls.
# Callers without an account (the legacy /try turns, which run only while
# Harbor is disabled, and a cookie-only trial's spec extraction) may cause at
# most 80% of it; the rest can be spent only by callers with an account.
CAS_LLM_DAILY_CALL_CAP=
# Admin API key (read-only usage reporting) for the /admin/costs dashboard.
ANTHROPIC_ADMIN_KEY=
# Floor date (YYYY-MM-DD) for the cost report fetch. Default 2026-03-15.
CAS_ANTHROPIC_EARLIEST_DATE=

# --- OpenAI ---
# Embeddings for Haven's memory retrieval. Unset runs memory in "lite" mode
# (recency only, no embeddings).
OPENAI_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# An arming switch: only true, 1, yes, on or enabled turn the payment bypass on
# for the feature-request flow (POST /features/:id/bypass-dev). false, 0, no,
# off, empty or anything else leaves it off. With NODE_ENV development or test
# every logged-in customer can use it on their own requests; with any other
# NODE_ENV only the ADMIN_EMAIL account can. Leave empty anywhere real money
# moves.
STRIPE_BYPASS=

# --- Email (Resend) ---
# Unset logs outgoing email as "skipped" instead of sending, and the contact form
# (which needs this key and ADMIN_EMAIL) answers 503 "could not be sent" instead
# of confirming a note that went nowhere. With NODE_ENV
# development or test and no key, the one-time verification and password-reset
# links are also printed to the server console on a line starting
# "[dev] Email is not configured." so a local signup can be completed without
# editing the database. That never happens in any other NODE_ENV, and never in a
# response or a page.
RESEND_API_KEY=
# Defaults to "Craft & Ship <noreply@craftandship.io>" when unset.
RESEND_FROM_EMAIL=
# Signing secret for bounce and complaint webhooks at POST /webhooks/resend.
# Unset makes that endpoint reject every call with a 500.
RESEND_WEBHOOK_SECRET=

# --- Monitoring and analytics ---
# Sentry error reporting. Unset disables it. Events have the request's query
# string and Referer removed before they are sent (src/instrument.ts), because
# reset and verification links carry their token there.
SENTRY_DSN=
# Plausible analytics site domain. Unset omits the analytics script.
PLAUSIBLE_DOMAIN=

# --- Service-to-service auth ---
# Bearer key for /ops/api/v1/*. Unset makes those routes return 503. The key
# is admin-equivalent (it can requeue, fail, delete and queue builds past
# payment, and read customer emails), so treat it like the admin password.
OPS_API_KEY=
# Bearer secret for the optional status hook POST /webhooks/build-status, which
# lets an external worker report building/testing/deploying/preview/failed over
# HTTP. The bundled worker does not use it (it writes the builds table directly),
# and the hook can never set a build live. Unset makes the endpoint reject every
# call with a 500.
WORKER_WEBHOOK_SECRET=

# --- Access and URLs ---
# Number of reverse proxies in front of the server. The client address used
# for rate limiting, and the HTTPS check that Secure cookies depend on, are
# read from that many hops of X-Forwarded-* headers.
#   0  nothing is in front: clients reach this server directly. This is what
#      a local run is, and the value this template ships.
#   1  one proxy that terminates TLS (Railway, a single nginx or load
#      balancer). Set this when you deploy behind one.
#   n  n proxies (for example a CDN in front of the platform's proxy).
# Too high lets any client forge X-Forwarded-For and walk past every
# per-address rate limit; too low makes all visitors share the proxy's address
# and stops the Secure session cookie from being issued, so nobody can log in.
# Unset (the line removed or left empty) means 1, with a warning at boot.
TRUST_PROXY_HOPS=0
# HTTP basic-auth password (any user name) that locks the site for a private
# beta. Not locked even when set: the public marketing pages, /health, /try,
# /ops/api (own bearer key), /webhooks (own signatures) and static asset
# paths. Unset leaves the whole site open, which is the normal state.
PREVIEW_PASSWORD=
# Public origin of this deployment, for example https://app.example.com (no
# trailing slash). Used for the links in verification and password reset
# emails and for the Stripe Checkout return URL; when unset those are built
# from the request's Host header, which is fine locally but lets the sender of
# a request choose the host on a deployment whose proxy forwards arbitrary
# Host headers, so set it in production. Every other email (links, images,
# unsubscribe) also uses it, falling back to https://craftandship.io.
BASE_URL=
# Comma-separated profile URLs emitted as schema.org sameAs on the Organization
# and on the founder Person node. Unset omits the key.
CAS_ORG_SAMEAS=
CAS_OCEAN_SAMEAS=

# --- Railway (only needed to manage customer-app infrastructure) ---
# Token used to delete customer Railway projects from /admin/builds/:id/delete.
RAILWAY_API_TOKEN=
# Token for the /admin/settings page, which reads and edits worker variables.
RAILWAY_ADMIN_TOKEN=
# Railway injects these two into every service; set them by hand for local use
# of /admin/settings. RAILWAY_WORKER_SERVICE_ID identifies the worker service.
# The project named by RAILWAY_PROJECT_ID (the one this server runs in) is
# always protected from the admin delete route, whatever the list below says.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_WORKER_SERVICE_ID=
# Every Railway write from this app (deleting a customer project, saving
# /admin/settings) is refused unless NODE_ENV=production AND this is true.
# Reads still work. Leave empty locally and on staging.
CAS_ALLOW_RAILWAY_WRITES=
# Comma-separated Railway project UUIDs the admin delete route must never
# touch (infrastructure and live-customer projects), in addition to
# RAILWAY_PROJECT_ID. Set it wherever CAS_ALLOW_RAILWAY_WRITES=true.
PROTECTED_RAILWAY_PROJECT_IDS=

# --- Build identification (shown on /health and used for asset cache-busting) ---
# Railway injects RAILWAY_GIT_COMMIT_SHA. Elsewhere set GIT_COMMIT and APP_VERSION.
GIT_COMMIT=
RAILWAY_GIT_COMMIT_SHA=
APP_VERSION=

# Daily budget line shown on the /admin/costs dashboard. Default 20 (USD).
COORDINATOR_DAILY_BUDGET=

# ---------------------------------------------------------------------------
# 3. Harbor (the Haven companion surface at /lighthouse/*)
# ---------------------------------------------------------------------------

# true (the default here) mounts the /lighthouse/* routes and redirects /try and
# /intake to the Haven conversation, and the legacy POST /try routes answer
# 404. That conversation is the product's only
# path from "I need a website" to a queued build, so a fresh checkout wants it
# on. Unset or false leaves the legacy intake pages, which can collect a spec
# but start no build, and the Harbor schema dormant. Needs ANTHROPIC_API_KEY to
# hold a conversation; without it the chat answers that the assistant is not
# configured, and everything else still works.
CAS_HARBOR_ENABLED=true
# true enables POST /lighthouse/bypass, which promotes a trial to a paying
# keeper without Stripe and logs the caller in as a NEW account for the email
# they give (an email that already has an account, or ADMIN_EMAIL, is refused).
# Honored only when NODE_ENV is development or test; ignored everywhere else.
CAS_HARBOR_STRIPE_BYPASS=
# How a build enters review when it arrives at preview: `pending` (a person
# reviews it at /admin/reviews) or, with this switched on, `ai_review_queued`,
# for an automated review loop that is not part of this repository (nothing
# here consumes that state). An arming switch: only true, 1, yes, on or enabled
# turn it on; empty or anything else leaves builds with a person. The build
# worker reads the same variable from its own environment; the web app reads
# it for the optional status hook (POST /webhooks/build-status), so that both
# put a build into review the same way. Leave it the same in both places.
CAS_HARBOR_AUTO_REVIEW=
# Conversation turns before the email gate appears. Default 22.
CAS_HARBOR_EMAIL_GATE_TURN_COUNT=
# Minimum conversation turns before a free build can be started. Default 4.
# Only turns the spec extraction may read count: a crisis message, or a turn
# a private (sacred) note was filed from, does not.
CAS_HARBOR_BUILD_MIN_TURNS=
# Rate limits on POST /lighthouse/table/turn: window in ms (default 900000),
# max turns per window for one trial (default 60) and for one client address
# (default 150; this is the one that still holds when a client discards its
# cookie on every request).
CAS_HARBOR_TURN_WINDOW_MS=
CAS_HARBOR_TURN_MAX=
CAS_HARBOR_TURN_IP_MAX=
# Build attempts per hour on POST /lighthouse/build for one trial (default 6;
# one client address gets four times this).
CAS_HARBOR_BUILD_MAX=
# New trials (cookie-less first visits) per client address per hour. Default 20.
CAS_HARBOR_TRIAL_MINT_MAX=
# Daily Anthropic spend caps for Haven conversation turns, in micro-dollars:
# per trial or keeper (default 5000000 = $5) and for everyone together
# (default 50000000 = $50). When the shared cap is reached nobody can take a
# model-backed turn until older turns leave the 24-hour window.
CAS_HARBOR_TURN_DAILY_COST_CAP_MICROS=
CAS_HARBOR_GLOBAL_DAILY_COST_CAP_MICROS=
# Directory of template-family thumbnails for /lighthouse/preview. Defaults to
# public/template-thumbnails.
CAS_TEMPLATE_THUMBNAILS_DIR=
# Override path to templates.json (test hook). Defaults to src/data/templates.json.
CAS_TEMPLATES_JSON_PATH=

# ---------------------------------------------------------------------------
# 4. Tuning (all have safe defaults; leave empty unless you know why)
# ---------------------------------------------------------------------------

# Haven memory retrieval: items fetched by similarity (default 8), by recency
# (default 5), the non-low-utility floor (default 10), and the SELECT row cap
# (default 5000).
COMPANION_MEMORY_TOP_K=
COMPANION_MEMORY_RECENT_N=
COMPANION_MEMORY_LOW_UTILITY_FLOOR=
COMPANION_MEMORY_MAX_FETCH_ROWS=

# Background job intervals in milliseconds.
# Abandoned-intake sweep, default 900000 (15 min).
ABANDON_CHECK_INTERVAL_MS=
# Follow-up email scheduler, default 300000 (5 min).
EMAIL_SCHEDULER_INTERVAL_MS=
# Harbor weekly sweeps, default 604800000 (7 days) each.
TOPIC_KB_SWEEP_INTERVAL_MS=
MEMORY_LOW_UTILITY_SWEEP_INTERVAL_MS=
RAIL_FLAG_SWEEP_INTERVAL_MS=
PERSONA_LEARNING_DIGEST_INTERVAL_MS=
