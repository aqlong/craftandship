  /* ─── Compat layer for status.js dynamic class mutations ─────────────────
     status.js adds/removes Tailwind utility class names on the progress
     stepper elements and injects banner divs with Tailwind utility class
     strings. These rules map those class names to Harbor warm-paper /
     lantern values so the page renders correctly without pulling in the
     full Tailwind /style.css. Selectors are scoped to the parent element
     so they have higher specificity than the base .progress-step-dot /
     .progress-step-label / .progress-connector rules above. */
  .progress-step-dot.bg-brand {
    background: var(--color-lantern);
    border-color: var(--color-lantern-deep);
  }
  .progress-step-dot.border-brand { border-color: var(--color-lantern-deep); }
  .progress-step-dot.text-brand   { color: var(--color-lantern-deep); }
  .progress-step-dot.text-black   { color: var(--color-ink); }
  .progress-step-dot.border-border { border-color: var(--color-rule); }
  .progress-step-dot.text-subtle   { color: var(--color-ink-faded); }
  .progress-step-dot.bg-bg         { background: var(--color-vellum); }
  .progress-step-dot.shadow-glow   { box-shadow: 0 0 0 4px rgba(198, 138, 58, 0.22); }
  .progress-step-label.text-brand    { color: var(--color-lantern-deep); }
  .progress-step-label.text-gray-100 { color: var(--color-ink); }
  .progress-step-label.text-subtle   { color: var(--color-ink-faded); }
  .progress-step-label.font-semibold { font-weight: 600; }
  .progress-connector.bg-brand  { background: var(--color-lantern); }
  .progress-connector.bg-border { background: var(--color-rule); }
  /* Tailwind utility classes status.js uses on injected banner divs */
  .text-center { text-align: center; }
  .p-8 { padding: 28px; }
  .p-5 { padding: 20px; }
  .mb-8 { margin-bottom: 24px; }
  .rounded-2xl, .rounded-xl { border-radius: 5px; }
  .border { border: 1px solid var(--color-rule); }
  .bg-surface-2 { background: var(--color-companion-paper); }
  /* Tailwind opacity-suffix utility names cast literally by status.js */
  [class*="bg-brand/[0.08]"] { background: rgba(198, 138, 58, 0.08); }
  [class*="border-brand/30"] { border: 1px solid rgba(198, 138, 58, 0.45); }
  /* status-failed-banner used by status.js for failure state */
  .status-failed-banner {
    padding: 22px 24px; margin-bottom: 24px;
    background: rgba(196, 70, 70, 0.06);
    border: 1px solid rgba(196, 70, 70, 0.32);
    border-radius: 5px;
    color: #8C3A3A;
  }
</style>
