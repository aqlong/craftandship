<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Your website is public</title>
  <link rel="icon" type="image/png" href="/brand-harbor/harbor-tab-icon.png">
  <style>
    :root {
      --color-oat:           #e8e0cd;
      --color-clay:          #b89683;
      --color-sage:          #7d8b6e;
      --color-ink-brown:     #3a2f24;
      --color-lantern-amber: #f4d29a;
      --color-slate-blue:    #5e7187;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--color-oat);
      color: var(--color-ink-brown);
      font-family: 'Tiempos Text', 'Iowan Old Style', Georgia, 'Times New Roman', serif;
      min-height: 100vh;
    }
    main { max-width: 560px; margin: 0 auto; padding: 96px 28px; text-align: center; }
    h1 { font-size: 36px; margin: 0 0 18px; font-weight: 600; line-height: 1.2; }
    p { line-height: 1.7; margin: 0 0 18px; }
    .eyebrow {
      text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px;
      color: var(--color-ink-brown); margin-bottom: 12px; font-weight: 600;
    }
    .url-line {
      display: inline-block;
      font-family: 'SF Mono', Menlo, Monaco, Consolas, monospace;
      font-size: 14px; color: var(--color-ink-brown);
      background: #fff;
      border: 1px solid rgba(184, 150, 131, 0.4);
      padding: 10px 16px; border-radius: 5px;
      margin-top: 8px;
    }
    .btn {
      display: inline-block;
      padding: 14px 28px;
      background: var(--color-ink-brown);
      color: #fff; text-decoration: none;
      border-radius: 6px; font-weight: 600;
      font-size: 16px; margin-top: 24px;
    }
    .btn:hover { background: #2a2017; }
    .btn-secondary {
      background: transparent;
      color: var(--color-ink-brown);
      border: 1px solid rgba(58, 47, 36, 0.35);
    }
    .small { font-size: 15px; color: #5e4f3a; }
  </style>
</head>
<body>
<%- include('../partials/_harbor-skip-link') %>
<main id="main">
  <% if (webhookSettled) { %>
    <p class="eyebrow">It is real now</p>
    <h1>Your website is public.</h1>
    <% const publicUrl = build.live_url || build.preview_url; %>
    <% if (publicUrl) { %>
      <p>
        <a class="btn" href="<%= httpUrl(publicUrl) %>" target="_blank" rel="noopener noreferrer">Visit your website</a>
      </p>
      <div class="url-line"><%= publicUrl %></div>
    <% } %>
    <p style="margin-top:32px;">Haven left a small note for you. You'll see it next time you open <a href="/lighthouse/table">your conversation</a>.</p>
    <p class="small"><a href="/lighthouse/lamp/<%= build.id %>">Manage your website and subscription</a></p>
  <% } else { %>
    <p class="eyebrow">Almost there</p>
    <h1>Your payment landed. Hold on for a second.</h1>
    <div role="status" aria-live="polite" id="publish-status">
      <p>Your website is being published right now. This takes a moment.</p>
      <p class="small">This page will update on its own as soon as your website goes live.</p>
    </div>
    <p style="margin-top:32px;"><a href="/lighthouse/lamp/<%= build.id %>" class="small">Skip the wait and go to your website</a></p>
    <script nonce="<%= cspNonce %>">
      (function () {
        var POLL_INTERVAL_MS = 5000;
        var SETTLED_MARKER = 'It is real now';
        function schedule() { setTimeout(poll, POLL_INTERVAL_MS); }
        function poll() {
          fetch(window.location.href, {
            credentials: 'same-origin',
            headers: { 'Accept': 'text/html' },
            cache: 'no-store'
          })
            .then(function (r) { return r.ok ? r.text() : null; })
            .then(function (html) {
              if (html && html.indexOf(SETTLED_MARKER) !== -1) {
                window.location.reload();
              } else {
                schedule();
              }
            })
            .catch(function () { schedule(); });
        }
        schedule();
      })();
    </script>
  <% } %>
</main>
</body>
</html>
