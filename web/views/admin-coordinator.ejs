<section class="max-w-[1400px] mx-auto px-3 py-4 sm:p-6 sm:pt-8 overflow-x-hidden">
  <%- include("_admin-nav") %>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
    <div class="bg-surface-3 rounded-[10px] px-4 sm:px-6 py-3 sm:py-4">
      <div class="text-[0.75rem] text-subtle mb-1 uppercase tracking-wider">Total</div>
      <div class="text-xl sm:text-2xl font-bold text-gray-200" data-stat="total"><%= stats.total %></div>
    </div>
    <div class="bg-surface-3 rounded-[10px] px-4 sm:px-6 py-3 sm:py-4">
      <div class="text-[0.75rem] text-subtle mb-1 uppercase tracking-wider">Pending</div>
      <div class="text-xl sm:text-2xl font-bold text-amber-400" data-stat="pending"><%= stats.pending %></div>
    </div>
    <div class="bg-surface-3 rounded-[10px] px-4 sm:px-6 py-3 sm:py-4">
      <div class="text-[0.75rem] text-subtle mb-1 uppercase tracking-wider">Running</div>
      <div class="text-xl sm:text-2xl font-bold text-brand-sky" data-stat="running"><%= stats.running %></div>
    </div>
    <div class="bg-surface-3 rounded-[10px] px-4 sm:px-6 py-3 sm:py-4">
      <div class="text-[0.75rem] text-subtle mb-1 uppercase tracking-wider">Completed</div>
      <div class="text-xl sm:text-2xl font-bold text-brand" data-stat="completed"><%= stats.completed %></div>
    </div>
    <div class="bg-surface-3 rounded-[10px] px-4 sm:px-6 py-3 sm:py-4">
      <div class="text-[0.75rem] text-subtle mb-1 uppercase tracking-wider">Failed</div>
      <div class="text-xl sm:text-2xl font-bold text-red-400" data-stat="failed"><%= stats.failed %></div>
    </div>
    <div class="bg-surface-3 rounded-[10px] px-4 sm:px-6 py-3 sm:py-4">
      <div class="text-[0.75rem] text-subtle mb-1 uppercase tracking-wider">Skipped</div>
      <div class="text-xl sm:text-2xl font-bold text-muted" data-stat="skipped"><%= stats.skipped %></div>
    </div>
  </div>

  <div class="bg-surface-3 rounded-[10px] p-3 sm:p-4 mb-6 flex flex-col sm:flex-row gap-3 items-stretch sm:items-end flex-wrap">
    <div>
      <label class="text-muted text-xs block mb-1">Agent</label>
      <select id="filter-agent" class="bg-bg text-gray-100 border border-border rounded-md px-3 py-2 text-sm w-full sm:w-auto">
        <option value="">All</option>
        <% agents.forEach(function(a) { %>
          <option value="<%= a %>" <% if (filters.agent === a) { %>selected<% } %>><%= a %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="text-muted text-xs block mb-1">Category</label>
      <select id="filter-category" class="bg-bg text-gray-100 border border-border rounded-md px-3 py-2 text-sm w-full sm:w-auto">
        <option value="">All</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c %>" <% if (filters.task_category === c) { %>selected<% } %>><%= c %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label class="text-muted text-xs block mb-1">Status</label>
      <select id="filter-status" class="bg-bg text-gray-100 border border-border rounded-md px-3 py-2 text-sm w-full sm:w-auto">
        <option value="">All</option>
        <% ['pending','running','completed','failed','skipped'].forEach(function(s) { %>
          <option value="<%= s %>" <% if (filters.status === s) { %>selected<% } %>><%= s %></option>
        <% }); %>
      </select>
    </div>
    <div class="grid grid-cols-2 sm:contents gap-3">
      <div>
        <label class="text-muted text-xs block mb-1">From</label>
        <input type="date" id="filter-date-from" value="<%= filters.date_from %>" class="bg-bg text-gray-100 border border-border rounded-md px-3 py-2 text-sm w-full sm:w-auto" />
      </div>
      <div>
        <label class="text-muted text-xs block mb-1">To</label>
        <input type="date" id="filter-date-to" value="<%= filters.date_to %>" class="bg-bg text-gray-100 border border-border rounded-md px-3 py-2 text-sm w-full sm:w-auto" />
      </div>
    </div>
    <div>
      <button id="apply-filters" class="btn btn-primary w-full sm:w-auto">Filter</button>
    </div>
  </div>

  <!-- Desktop table -->
  <div class="hidden lg:block bg-surface-3 rounded-[10px] overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Description</th>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Agent</th>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Category</th>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Status</th>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Created</th>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Duration</th>
          <th class="px-4 py-3 text-left text-subtle font-semibold border-b border-border whitespace-nowrap">Cost</th>
        </tr>
      </thead>
      <tbody>
        <% if (tasks.length === 0) { %>
          <tr><td colspan="7" class="text-center text-subtle py-8">No tasks found.</td></tr>
        <% } %>
        <% tasks.forEach(function(t) { %>
          <tr class="border-b border-surface-3 last:border-b-0 hover:bg-surface-2">
            <td class="px-4 py-2.5 text-gray-300 max-w-[350px] overflow-hidden text-ellipsis whitespace-nowrap" title="<%= t.task_description || '' %>"><%= t.task_description || '(no description)' %></td>
            <td class="px-4 py-2.5 text-gray-300"><%= t.agent %></td>
            <td class="px-4 py-2.5 text-muted text-xs"><%= t.task_category %></td>
            <td class="px-4 py-2.5">
              <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold
                <% if (t.status === 'completed') { %>bg-[rgba(42,190,170,0.15)] text-[#2ABEAA]<% } %>
                <% if (t.status === 'failed') { %>bg-red-900 text-red-300<% } %>
                <% if (t.status === 'running') { %>bg-[rgba(168,155,122,0.15)] text-[#A89B7A]<% } %>
                <% if (t.status === 'pending') { %>bg-amber-900 text-amber-300<% } %>
                <% if (t.status === 'skipped') { %>bg-surface-2 text-muted<% } %>
              "><%= t.status %></span>
            </td>
            <td class="px-4 py-2.5 text-subtle text-xs whitespace-nowrap"><span data-ts="<%= new Date(t.created_at).toISOString() %>" data-ts-fmt="datetime"><%= new Date(t.created_at).toISOString().slice(0, 16).replace('T', ' ') %> UTC</span></td>
            <td class="px-4 py-2.5 text-subtle text-xs whitespace-nowrap"><% if (t.duration_s != null) { %><%= t.duration_s < 60 ? Math.round(t.duration_s) + 's' : Math.round(t.duration_s / 60) + 'm' %><% } else if (t.status === 'running') { %><span class="text-yellow-400">running</span><% } else { %>-<% } %></td>
            <td class="px-4 py-2.5 text-gray-300 text-xs whitespace-nowrap"><% if (t.actual_cost_usd != null) { %><%= fmtUsd(t.actual_cost_usd, 4) %><% } else { %>-<% } %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Mobile/tablet card view -->
  <div class="lg:hidden space-y-3">
    <% if (tasks.length === 0) { %>
      <div class="text-center text-subtle py-8">No tasks found.</div>
    <% } %>
    <% tasks.forEach(function(t) { %>
      <div class="bg-surface rounded-lg p-4">
        <div class="flex justify-between items-start mb-2">
          <span class="text-gray-200 text-sm font-semibold flex-1 mr-2 break-words" title="<%= t.task_description || '' %>"><%= t.task_description ? (t.task_description.length > 80 ? t.task_description.slice(0, 80) + '...' : t.task_description) : '(no description)' %></span>
          <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold shrink-0
            <% if (t.status === 'completed') { %>bg-[rgba(42,190,170,0.15)] text-[#2ABEAA]<% } %>
            <% if (t.status === 'failed') { %>bg-red-900 text-red-300<% } %>
            <% if (t.status === 'running') { %>bg-[rgba(168,155,122,0.15)] text-[#A89B7A]<% } %>
            <% if (t.status === 'pending') { %>bg-amber-900 text-amber-300<% } %>
            <% if (t.status === 'skipped') { %>bg-surface-2 text-muted<% } %>
          "><%= t.status %></span>
        </div>
        <div class="flex justify-between text-xs mb-1">
          <span class="text-subtle">Agent</span>
          <span class="text-gray-300"><%= t.agent %></span>
        </div>
        <div class="flex justify-between text-xs mb-1">
          <span class="text-subtle">Category</span>
          <span class="text-muted"><%= t.task_category %></span>
        </div>
        <div class="flex justify-between text-xs mb-1">
          <span class="text-subtle">Created</span>
          <span class="text-muted"><span data-ts="<%= new Date(t.created_at).toISOString() %>" data-ts-fmt="datetime"><%= new Date(t.created_at).toISOString().slice(0, 16).replace('T', ' ') %> UTC</span></span>
        </div>
        <div class="flex justify-between text-xs mb-1">
          <span class="text-subtle">Duration</span>
          <span class="text-muted"><% if (t.duration_s != null) { %><%= t.duration_s < 60 ? Math.round(t.duration_s) + 's' : Math.round(t.duration_s / 60) + 'm' %><% } else if (t.status === 'running') { %><span class="text-yellow-400">running</span><% } else { %>-<% } %></span>
        </div>
        <% if (t.actual_cost_usd != null) { %>
        <div class="flex justify-between text-xs mb-1">
          <span class="text-subtle">Cost</span>
          <span class="text-gray-300"><%= fmtUsd(t.actual_cost_usd, 4) %></span>
        </div>
        <% } %>
      </div>
    <% }); %>
  </div>

  <% var totalPages = Math.ceil(total / pageSize); %>
  <% if (totalPages > 1) { %>
    <div class="flex justify-center gap-2 mt-6 flex-wrap items-center">
      <% if (page > 1) { %>
        <a href="?page=<%= page - 1 %>&agent=<%= filters.agent %>&task_category=<%= filters.task_category %>&status=<%= filters.status %>&date_from=<%= filters.date_from %>&date_to=<%= filters.date_to %>"
           class="px-3 py-2 min-h-[44px] flex items-center bg-surface-2 text-gray-200 rounded text-sm no-underline hover:bg-surface-2">Prev</a>
      <% } %>
      <span class="px-3 py-2 text-muted text-sm">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a href="?page=<%= page + 1 %>&agent=<%= filters.agent %>&task_category=<%= filters.task_category %>&status=<%= filters.status %>&date_from=<%= filters.date_from %>&date_to=<%= filters.date_to %>"
           class="px-3 py-2 min-h-[44px] flex items-center bg-surface-2 text-gray-200 rounded text-sm no-underline hover:bg-surface-2">Next</a>
      <% } %>
    </div>
  <% } %>

  <%- include("partials/_admin-auto-refresh", { intervalSeconds: 60 }) %>
</section>

<script nonce="<%= cspNonce %>">
(function() {
  document.getElementById('apply-filters').addEventListener('click', function() {
    var params = new URLSearchParams();
    var agent = document.getElementById('filter-agent').value;
    var category = document.getElementById('filter-category').value;
    var status = document.getElementById('filter-status').value;
    var dateFrom = document.getElementById('filter-date-from').value;
    var dateTo = document.getElementById('filter-date-to').value;
    if (agent) params.set('agent', agent);
    if (category) params.set('task_category', category);
    if (status) params.set('status', status);
    if (dateFrom) params.set('date_from', dateFrom);
    if (dateTo) params.set('date_to', dateTo);
    window.location = '/admin/coordinator' + (params.toString() ? '?' + params.toString() : '');
  });
})();
</script>
