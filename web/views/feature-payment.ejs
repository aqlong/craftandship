<section style="padding:64px 0 96px;">
  <div class="max-site" style="max-width:680px;">
    <div class="feature-pay-card">
      <span class="eyebrow" style="font-size:14px; display:block; margin-bottom:8px;">Almost there,</span>
      <h1 class="display feature-pay-card__title">Approve and pay.</h1>

      <div class="feature-pay-summary">
        <span class="caps feature-pay-summary__head">Order summary</span>

        <div class="feature-pay-summary__row">
          <span class="feature-pay-summary__label">Project</span>
          <span class="feature-pay-summary__value"><%= appName %></span>
        </div>
        <div class="feature-pay-summary__row">
          <span class="feature-pay-summary__label">Feature</span>
          <span class="feature-pay-summary__value"><%= feature.description || 'Feature request' %></span>
        </div>
        <div class="feature-pay-summary__row">
          <span class="feature-pay-summary__label">Scope</span>
          <span class="feature-pay-summary__value feature-pay-summary__value--soft"><%= feature.scope_summary %></span>
        </div>
        <div class="feature-pay-summary__row">
          <span class="feature-pay-summary__label">Size</span>
          <span class="feature-pay-summary__value"><%= sizeLabel %></span>
        </div>

        <div class="feature-pay-summary__rule"></div>

        <div class="feature-pay-summary__total">
          <span class="feature-pay-summary__total-label">Total</span>
          <span class="feature-pay-summary__total-amount"><%= costDisplay %></span>
        </div>
      </div>

      <% if (devMode) { %>
        <form action="/features/<%= feature.id %>/bypass-dev" method="POST" class="feature-pay-dev">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <span class="caps feature-pay-dev__head">Dev mode &middot; skip payment</span>
          <button type="submit" class="btn btn-secondary feature-pay-dev__btn">Bypass payment and queue feature</button>
        </form>
      <% } %>

      <div class="feature-pay-foot">
        <a href="/features/<%= feature.id %>" class="btn btn-secondary">&larr; Back to feature</a>
        <a href="/dashboard" class="btn btn-tertiary">Dashboard</a>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-pay-card {
    background: var(--color-vellum);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    box-shadow: var(--shadow-letter);
    padding: 44px 44px 36px;
  }
  @media (max-width: 600px) { .feature-pay-card { padding: 28px 24px 24px; } }
  .feature-pay-card__title {
    font-size: 38px; line-height: 1.05; margin: 0 0 28px;
    letter-spacing: -0.012em;
  }
  @media (max-width: 600px) { .feature-pay-card__title { font-size: 30px; } }

  .feature-pay-summary {
    background: var(--color-companion-paper);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    padding: 22px 24px;
    margin-bottom: 28px;
  }
  .feature-pay-summary__head { color: var(--color-clay); display: block; margin-bottom: 14px; }
  .feature-pay-summary__row {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 18px; padding: 6px 0;
  }
  .feature-pay-summary__label {
    font-family: var(--font-body); font-size: 14px;
    color: var(--color-ink-soft); min-width: 110px;
  }
  .feature-pay-summary__value {
    font-family: var(--font-body); font-size: 14px;
    color: var(--color-ink); text-align: right; line-height: 1.45;
  }
  .feature-pay-summary__value--soft {
    font-family: var(--font-display); font-style: italic;
    color: var(--color-ink-soft);
  }
  .feature-pay-summary__rule { border-top: 1px dashed var(--color-rule); margin: 12px 0; }
  .feature-pay-summary__total {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 8px 0 4px;
  }
  .feature-pay-summary__total-label { font-family: var(--font-body); font-size: 14px; color: var(--color-ink-soft); }
  .feature-pay-summary__total-amount {
    font-family: var(--font-display); font-size: 32px;
    color: var(--color-ink); letter-spacing: -0.01em;
  }

  .feature-pay-dev {
    margin: 8px 0 22px;
    padding: 16px 20px;
    border: 1px dashed var(--color-lantern-deep);
    border-radius: 5px;
    background: rgba(198, 138, 58, 0.05);
    display: flex; flex-direction: column; gap: 10px;
  }
  .feature-pay-dev__head { color: var(--color-lantern-deep); display: block; }
  .feature-pay-dev__btn { width: 100%; justify-content: center; }

  .feature-pay-foot {
    display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px dashed var(--color-rule);
  }
</style>
