<section style="padding:48px 0 96px;">
  <div class="max-site" style="max-width:980px;">
    <div class="features-head">
      <div>
        <span class="eyebrow" style="font-size:14px; display:block; margin-bottom:8px;">Your website,</span>
        <h1 class="display features-title"><%= build.app_name || 'Your project' %></h1>
        <% if (build.live_url) { %>
          <p class="features-meta">
            <a href="<%= httpUrl(build.live_url) %>" target="_blank" rel="noopener noreferrer" class="features-meta__link">Visit the site &rarr;</a>
          </p>
        <% } %>
      </div>
      <form action="/projects/<%= build.id %>/features/new" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-primary">Request a new feature &rarr;</button>
      </form>
    </div>

    <% if (features.length === 0) { %>
      <div class="features-empty">
        <span class="hand" style="font-size:28px; color:var(--color-ink-pencil); display:block; margin-bottom:14px;">When you're ready,</span>
        <h2 class="display features-empty__title">Want to add something new?</h2>
        <p class="features-empty__lede">Describe what you want. We'll scope the work and give you an honest estimate.</p>
        <form action="/projects/<%= build.id %>/features/new" method="POST" style="margin-top:24px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-primary">Request your first feature &rarr;</button>
        </form>
      </div>
    <% } else { %>
      <div class="features-table-wrap">
        <table class="features-table">
          <thead>
            <tr>
              <th>Description</th>
              <th>Status</th>
              <th>Cost</th>
              <th class="features-table__hide-mobile">Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% features.forEach(function(feature) { %>
              <tr>
                <td class="features-table__name"><%= feature.description || feature.scope_summary || 'In progress...' %></td>
                <td><span class="features-pill features-pill--<%= feature.status %>"><%= statusLabels[feature.status] || feature.status %></span></td>
                <td>
                  <% if (feature.estimated_cost) { %>$<%= (feature.estimated_cost / 100).toFixed(0) %><% } else { %><span style="color:var(--color-ink-faded);">Pending</span><% } %>
                </td>
                <td class="features-table__hide-mobile features-table__date"><span data-ts="<%= new Date(feature.created_at).toISOString() %>" data-ts-fmt="datetime"><%= new Date(feature.created_at).toISOString().slice(0, 10) %></span></td>
                <td>
                  <div class="features-actions">
                    <% if (feature.status === 'drafting') { %>
                      <a href="/features/<%= feature.id %>" class="btn btn-tertiary btn-sm">Continue</a>
                    <% } else if (feature.status === 'scoped') { %>
                      <a href="/features/<%= feature.id %>" class="btn btn-primary btn-sm">Review scope</a>
                    <% } else if (feature.status === 'payment_pending') { %>
                      <a href="/features/<%= feature.id %>/pay" class="btn btn-primary btn-sm">Pay now</a>
                    <% } else { %>
                      <a href="/features/<%= feature.id %>" class="btn btn-tertiary btn-sm">View</a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="features-foot">
      <a href="/builds/<%= build.id %>" class="btn btn-secondary">&larr; Back to project</a>
      <a href="/dashboard" class="btn btn-tertiary">Dashboard</a>
    </div>
  </div>
</section>

<style>
  .features-head {
    display: flex; flex-wrap: wrap; gap: 18px;
    justify-content: space-between; align-items: flex-end;
    margin-bottom: 32px;
  }
  .features-title {
    font-size: 44px; line-height: 1.05; margin: 0;
    letter-spacing: -0.012em;
  }
  @media (max-width: 600px) { .features-title { font-size: 32px; } }
  .features-meta { font-size: 14px; color: var(--color-ink-soft); margin: 8px 0 0; }
  .features-meta__link { color: var(--color-clay); text-decoration: none; font-weight: 600; }
  .features-meta__link:hover { color: var(--color-lantern-deep); }

  .features-empty {
    text-align: center;
    padding: 64px 32px;
    background: var(--color-companion-paper);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    box-shadow: var(--shadow-letter);
  }
  .features-empty__title {
    font-size: 32px; line-height: 1.1; margin: 0 0 12px;
    letter-spacing: -0.012em;
  }
  .features-empty__lede {
    font-size: 16px; color: var(--color-ink-soft); margin: 0;
    line-height: 1.55; max-width: 440px; margin: 0 auto;
  }

  .features-table-wrap {
    overflow-x: auto;
    background: var(--color-vellum);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    box-shadow: var(--shadow-slip);
  }
  .features-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
  }
  .features-table th {
    text-align: left;
    padding: 14px 20px;
    font-family: var(--font-body); font-size: 11px; font-weight: 600;
    color: var(--color-clay); letter-spacing: 0.08em; text-transform: uppercase;
    background: var(--color-companion-paper);
    border-bottom: 1px solid var(--color-rule);
  }
  .features-table tbody tr { border-bottom: 1px solid var(--color-rule-soft); transition: background .12s ease; }
  .features-table tbody tr:last-child { border-bottom: none; }
  .features-table tbody tr:hover { background: rgba(165, 111, 79, 0.04); }
  .features-table td { padding: 14px 20px; font-size: 14px; color: var(--color-ink); vertical-align: middle; }
  .features-table__name { font-weight: 600; }
  .features-table__date { color: var(--color-ink-soft); white-space: nowrap; }
  @media (max-width: 720px) { .features-table__hide-mobile { display: none; } }

  .features-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 5px;
    font-family: var(--font-body); font-size: 11px; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase;
    background: rgba(110, 138, 122, 0.1);
    border: 1px solid var(--color-companion-rule);
    color: var(--color-companion-deep);
  }
  .features-pill--drafting { background: rgba(198, 138, 58, 0.1); border-color: rgba(198, 138, 58, 0.32); color: var(--color-lantern-deep); }
  .features-pill--scoped { background: rgba(110, 138, 122, 0.1); border-color: var(--color-companion-rule); color: var(--color-companion-deep); }
  .features-pill--payment_pending { background: rgba(198, 138, 58, 0.12); border-color: var(--color-lantern-deep); color: var(--color-lantern-deep); }
  .features-pill--building, .features-pill--testing, .features-pill--deploying { background: rgba(165, 111, 79, 0.1); border-color: rgba(165, 111, 79, 0.32); color: var(--color-clay); }
  .features-pill--complete, .features-pill--shipped { background: rgba(110, 138, 122, 0.12); border-color: var(--color-companion-rule); color: var(--color-companion-deep); }
  .features-pill--cancelled, .features-pill--failed { background: rgba(196, 70, 70, 0.06); border-color: rgba(196, 70, 70, 0.32); color: #8C3A3A; }

  .features-actions { display: flex; gap: 6px; flex-wrap: wrap; }

  .features-foot {
    display: flex; gap: 12px; flex-wrap: wrap;
    justify-content: center;
    margin-top: 36px;
  }
</style>
