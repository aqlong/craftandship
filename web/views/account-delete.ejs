<%
  var deleteError = typeof error !== 'undefined' ? error : null;
%>

<section style="padding:64px 0 96px;">
  <div class="max-site" style="max-width:560px;">
    <div style="background:var(--color-companion-paper); padding:48px; box-shadow:var(--shadow-letter); border-radius: 5px;">
      <span class="eyebrow" style="font-size:18px; display:block; margin-bottom:10px;">Account,</span>
      <h1 class="display" style="font-size:40px; line-height:1.05; margin:0 0 18px; letter-spacing:-0.012em;">
        Delete <em style="color:var(--color-clay);">your account.</em>
      </h1>
      <p style="font-size:17px; color:var(--color-ink-soft); line-height:1.6; margin:0 0 28px;">
        This permanently removes your account and your personal information. The action can't be undone. If you'd rather pause for a while, write to Ocean instead.
      </p>

      <% if (deleteError) { %>
        <div style="padding:14px 18px; margin-bottom:22px; background:#FBE7DC; border:1px solid var(--color-clay); border-radius: 5px; font-family:var(--font-display); font-style:italic; color:var(--color-ink); font-size:17px;" role="alert">
          <%= deleteError %>
        </div>
      <% } %>

      <form action="/account/delete" method="POST" style="display:flex; flex-direction:column; gap:22px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label style="display:flex; flex-direction:column; gap:8px;">
          <span style="font-family:var(--font-display); font-style:italic; font-size:17px; color:var(--color-clay);">Confirm your password</span>
          <input type="password" name="password" required autocomplete="current-password" autofocus
                 style="font-family:var(--font-body); font-size:17px; color:var(--color-ink); padding:13px 16px; border:1px solid var(--color-rule); background:var(--color-vellum); border-radius: 5px; outline:none;" />
        </label>

        <button type="submit" class="account-delete__btn"
                style="display:inline-flex; align-items:center; gap:10px; padding:11px 22px; font-family:var(--font-body); font-size:14px; font-weight:600; letter-spacing:0.02em; border:1px solid #B45A3F; background:transparent; color:#B45A3F; cursor:pointer; border-radius: 5px; align-self:flex-start; transition:background .15s ease, color .15s ease;">
          Permanently delete my account
        </button>
      </form>

      <div style="margin-top:28px; padding-top:18px; border-top:1px dashed var(--color-rule); font-family:var(--font-display); font-style:italic; font-size:15px; color:var(--color-ink-faded);">
        <a href="/dashboard" style="color:var(--color-ink-soft);">Take me back</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hover state (was inline onmouseover/onmouseout, which the CSP blocks). */
  .account-delete__btn:hover { background: #B45A3F !important; color: var(--color-vellum) !important; }
</style>
