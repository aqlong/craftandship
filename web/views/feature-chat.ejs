<section style="padding:48px 0 96px;">
  <div class="max-site" style="max-width:1100px;">
    <div class="feature-head">
      <span class="eyebrow" style="font-size:14px; display:block; margin-bottom:8px;">A new feature,</span>
      <h1 class="display feature-title">Tell us what you'd like to add.</h1>
      <p class="feature-lede">For <strong><%= build.app_name || 'your website' %></strong>. We'll scope the work and give you an honest estimate.</p>
    </div>

    <div class="feature-grid">
      <div class="feature-chat">
        <div id="chat-messages" class="feature-chat__messages" role="log" aria-live="polite">
          <% messages.forEach(function(msg) { %>
            <div class="harbor-chat-row harbor-chat-row--<%= msg.role %>">
              <div class="harbor-chat-bubble harbor-chat-bubble--<%= msg.role %>">
                <pre class="harbor-chat-text"><%= msg.content %></pre>
              </div>
            </div>
          <% }); %>
        </div>

        <% if (!scopeComplete) { %>
          <div class="feature-chat__input" id="chat-input-area">
            <textarea id="message-input" class="feature-chat__textarea" placeholder="Describe the feature, or answer the question above." rows="3" aria-label="Type your message"></textarea>
            <button id="send-btn" class="btn btn-primary">Send</button>
          </div>
        <% } %>
      </div>

      <aside class="feature-aside">
        <div id="scope-panel" class="feature-scope" style="<%= scopeComplete ? '' : 'display:none;' %>">
          <span class="caps feature-scope__head">Scope</span>
          <h2 class="display feature-scope__title">Review and approve.</h2>
          <p class="feature-scope__lede">Take a look. When it's right, you continue.</p>

          <div id="scope-content" class="feature-scope__content">
            <% if (feature.scope_summary) { %>
              <div class="feature-scope__row">
                <span class="caps feature-scope__row-head">Description</span>
                <span class="feature-scope__row-body"><%= feature.description %></span>
              </div>
              <div class="feature-scope__row">
                <span class="caps feature-scope__row-head">Scope</span>
                <span class="feature-scope__row-body"><%= feature.scope_summary %></span>
              </div>
              <div class="feature-scope__row">
                <span class="caps feature-scope__row-head">Estimated cost</span>
                <span class="feature-scope__row-body feature-scope__row-body--price">
                  <% if (feature.estimated_cost) { %>$<%= (feature.estimated_cost / 100).toFixed(0) %><% } %>
                </span>
              </div>
            <% } %>
          </div>

          <% if (feature.status === 'scoped') { %>
            <form action="/features/<%= feature.id %>/approve" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-primary feature-scope__cta">Approve and continue to payment &rarr;</button>
            </form>
          <% } else if (feature.status === 'payment_pending') { %>
            <a href="/features/<%= feature.id %>/pay" class="btn btn-primary feature-scope__cta">Continue to payment &rarr;</a>
          <% } %>
        </div>
      </aside>
    </div>
  </div>
</section>

<script nonce="<%= cspNonce %>">
  window.FEATURE_ID = <%- safeJSON(feature.id) %>;
  window.FEATURE_CSRF_TOKEN = <%- safeJSON(csrfToken) %>;
  window.FEATURE_SCOPE_COMPLETE = <%= scopeComplete ? 'true' : 'false' %>;
  window.FEATURE_BUILD_ID = <%- safeJSON(build.id) %>;
  window.FEATURE_DEV_MODE = <%= devMode ? 'true' : 'false' %>;
</script>
<script nonce="<%= cspNonce %>" src="/feature-chat.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>

<style>
  .feature-head { margin-bottom: 28px; }
  .feature-title {
    font-size: 40px; line-height: 1.05; margin: 0 0 10px;
    letter-spacing: -0.012em;
  }
  @media (max-width: 600px) { .feature-title { font-size: 30px; } }
  .feature-lede { font-size: 16px; color: var(--color-ink-soft); line-height: 1.55; margin: 0; max-width: 600px; }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 900px) { .feature-grid { grid-template-columns: 1fr; gap: 20px; } }

  .feature-chat {
    background: var(--color-vellum);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    box-shadow: var(--shadow-slip);
    display: flex; flex-direction: column;
    height: clamp(440px, 70vh, 660px);
  }
  .feature-chat__messages {
    flex: 1; overflow-y: auto;
    padding: 24px;
    display: flex; flex-direction: column; gap: 14px;
    scroll-behavior: smooth;
    background-image:
      radial-gradient(rgba(126, 100, 72, 0.04) 1px, transparent 1px),
      radial-gradient(rgba(126, 100, 72, 0.03) 1px, transparent 1px);
    background-size: 3px 3px, 7px 7px;
    background-position: 0 0, 1px 2px;
  }

  .harbor-chat-row { display: flex; max-width: 82%; }
  .harbor-chat-row--user { align-self: flex-end; }
  .harbor-chat-row--assistant { align-self: flex-start; }

  .harbor-chat-bubble {
    padding: 14px 18px;
    border-radius: 5px;
    border: 1px solid var(--color-rule);
    box-shadow: 0 1px 0 rgba(255, 250, 235, 0.40) inset, 0 2px 6px rgba(58, 42, 31, 0.06);
  }
  .harbor-chat-bubble--user { background: var(--color-ink); color: var(--color-vellum); border-color: var(--color-ink); }
  .harbor-chat-bubble--assistant { background: var(--color-companion-paper); color: var(--color-ink); }
  .harbor-chat-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px; line-height: 1.6;
    white-space: pre-wrap; word-break: break-word;
  }
  .harbor-chat-bubble--user .harbor-chat-text { color: var(--color-vellum); }

  .feature-chat__input {
    display: flex; gap: 10px;
    padding: 14px;
    border-top: 1px solid var(--color-rule);
    background: var(--color-companion-paper);
    border-radius: 0 0 5px 5px;
  }
  .feature-chat__textarea {
    flex: 1;
    font-family: var(--font-body); font-size: 15px;
    color: var(--color-ink);
    background: var(--color-vellum);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    padding: 10px 14px;
    resize: none;
    line-height: 1.55;
    outline: none;
    transition: border-color .15s ease;
  }
  .feature-chat__textarea:focus { border-color: var(--color-ink); }

  .feature-aside { position: sticky; top: 96px; }
  @media (max-width: 900px) { .feature-aside { position: static; } }

  .feature-scope {
    background: var(--color-companion-paper);
    border: 1px solid var(--color-rule);
    border-top: 3px solid var(--color-lantern);
    border-radius: 5px;
    box-shadow: var(--shadow-slip);
    padding: 24px;
  }
  .feature-scope__head { color: var(--color-clay); display: block; margin-bottom: 8px; }
  .feature-scope__title { font-size: 24px; line-height: 1.15; margin: 0 0 8px; letter-spacing: -0.005em; }
  .feature-scope__lede {
    font-family: var(--font-display); font-style: italic;
    font-size: 14px; color: var(--color-ink-soft);
    margin: 0 0 18px; line-height: 1.5;
  }
  .feature-scope__content { display: flex; flex-direction: column; gap: 12px; margin-bottom: 18px; }
  .feature-scope__row { display: flex; flex-direction: column; gap: 4px; padding-bottom: 10px; border-bottom: 1px solid var(--color-rule-soft); }
  .feature-scope__row:last-child { border-bottom: none; padding-bottom: 0; }
  .feature-scope__row-head { color: var(--color-ink-faded); }
  .feature-scope__row-body { font-size: 14px; color: var(--color-ink); line-height: 1.5; }
  .feature-scope__row-body--price { font-family: var(--font-display); font-size: 22px; color: var(--color-ink); font-weight: 500; }
  .feature-scope__cta { width: 100%; justify-content: center; }
</style>
