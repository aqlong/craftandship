<%
  var fpMessage = typeof message !== 'undefined' ? message : null;
  var fpError = typeof error !== 'undefined' ? error : null;
%>

<section class="harbor-auth">
  <div class="harbor-auth__inner">
    <div class="harbor-auth__card">
      <span class="eyebrow" style="font-size:18px; display:block; margin-bottom:10px;">Account recovery,</span>
      <h1 class="display harbor-auth__title">Reset your password.</h1>
      <p style="font-size:17px; color:var(--color-ink-soft); line-height:1.55; margin:14px 0 28px;">
        Enter your email and we'll send a link to get you back in.
      </p>

      <% if (fpMessage) { %>
        <div class="harbor-auth__notice" role="status">
          <p style="font-family:var(--font-display); font-style:italic; font-size:18px; margin:0; color:var(--color-ink); line-height:1.5;">
            <%= fpMessage %>
          </p>
        </div>
      <% } else if (fpError) { %>
        <div class="harbor-auth__error" role="alert"><%= fpError %></div>
      <% } %>

      <% if (!fpMessage) { %>
        <form action="/forgot-password" method="POST" class="harbor-auth__form">
          <%- include('_csrf-field') %>
          <label class="harbor-auth__field">
            <span class="harbor-auth__label">Email</span>
            <input type="email" name="email" required autocomplete="email" autofocus />
          </label>
          <button type="submit" class="btn btn-primary harbor-auth__submit">Send the reset link &rarr;</button>
        </form>
      <% } %>

      <div class="harbor-auth__footnote">
        <a href="/login">Back to sign in</a>
      </div>
    </div>
  </div>
</section>

<style>
  .harbor-auth { padding:64px 0 96px; }
  .harbor-auth__inner { max-width:440px; margin:0 auto; padding: 0 20px; box-sizing: border-box; }
  .harbor-auth__card {
    background:var(--color-companion-paper);
    padding:48px 48px 44px;
    box-shadow:var(--shadow-letter);
    border-radius: 5px;
  }
  .harbor-auth__title { font-size:44px; line-height:1.04; margin:0; letter-spacing:-0.012em; }
  @media (max-width: 600px) {
    .harbor-auth__card { padding:32px 24px 28px; }
    .harbor-auth__title { font-size:32px; }
  }
  .harbor-auth__notice {
    padding:18px 20px; margin-bottom:22px;
    background:var(--color-vellum); border-left:3px solid var(--color-lantern);
    border-radius: 5px;
  }
  .harbor-auth__error {
    padding:14px 18px; margin-bottom:22px;
    background:#FBE7DC; border:1px solid var(--color-clay); border-radius: 5px;
    font-family:var(--font-display); font-style:italic; color:var(--color-ink); font-size:17px;
  }
  .harbor-auth__form { display:flex; flex-direction:column; gap:22px; }
  .harbor-auth__field { display:flex; flex-direction:column; gap:8px; }
  .harbor-auth__label {
    font-family:var(--font-display); font-style:italic; font-size:17px; color:var(--color-clay);
  }
  .harbor-auth__form input {
    font-family:var(--font-body); font-size:17px; color:var(--color-ink);
    padding:13px 16px; border:1px solid var(--color-rule);
    background:var(--color-vellum);
    border-radius: 5px; outline:none;
  }
  .harbor-auth__form input:focus { border-color:var(--color-ink); }
  .harbor-auth__submit { margin-top:6px; align-self:flex-start; }
  .harbor-auth__footnote {
    margin-top:14px; padding-top:18px; border-top:1px dashed var(--color-rule);
    font-family:var(--font-display); font-style:italic; font-size:15px; color:var(--color-ink-faded); text-align:center;
  }
  .harbor-auth__footnote a { color:var(--color-ink-soft); }
</style>
