<%
  var signupError = typeof error !== 'undefined' ? error : null;
  var nameValue = typeof name !== 'undefined' ? name : '';
  var emailValue = typeof email !== 'undefined' ? email : '';
%>

<section class="harbor-auth">
  <div class="harbor-auth__inner">
    <div class="harbor-auth__card">
      <span class="eyebrow" style="font-size:15px; display:block; margin-bottom:6px;">Create your account,</span>
      <h1 class="display harbor-auth__title">Begin together.</h1>
      <p style="font-size:14px; color:var(--color-ink-soft); line-height:1.55; margin:10px 0 22px;">
        Already have one? <a href="/login" style="color:var(--color-clay);">Sign in.</a>
      </p>

      <% if (signupError) { %>
        <div class="harbor-auth__error" role="alert"><%= signupError %></div>
      <% } %>

      <form action="/signup" method="POST" class="harbor-auth__form">
        <%- include('_csrf-field') %>

        <label class="harbor-auth__field">
          <span class="harbor-auth__label">Your name</span>
          <input type="text" name="name" value="<%= nameValue %>" required autocomplete="name" autofocus />
        </label>

        <label class="harbor-auth__field">
          <span class="harbor-auth__label">Your email</span>
          <input type="email" name="email" value="<%= emailValue %>" required autocomplete="email" />
        </label>

        <label class="harbor-auth__field">
          <span class="harbor-auth__label">Choose a password</span>
          <input type="password" name="password" required minlength="8" autocomplete="new-password" />
          <span class="harbor-auth__hint">At least 8 characters.</span>
        </label>

        <p class="harbor-auth__terms">
          By creating an account, you agree to our
          <a href="/terms" target="_blank">Terms</a> and
          <a href="/privacy" target="_blank">Privacy</a>.
        </p>

        <button type="submit" class="btn btn-primary harbor-auth__submit">Create your account &rarr;</button>
      </form>
    </div>
  </div>
</section>

<style>
  .harbor-auth { padding:48px 0 80px; }
  .harbor-auth__inner { max-width:440px; margin:0 auto; padding: 0 20px; box-sizing: border-box; }
  .harbor-auth__card {
    background:var(--color-companion-paper);
    padding:32px 32px 28px;
    box-shadow:var(--shadow-letter);
    border-radius: 5px;
  }
  .harbor-auth__title { font-size:32px; line-height:1.04; margin:0; letter-spacing:-0.01em; }
  @media (max-width: 600px) {
    .harbor-auth__card { padding:24px 22px 22px; }
    .harbor-auth__title { font-size:28px; }
  }

  .harbor-auth__error {
    padding:11px 14px; margin-bottom:18px;
    background:#FBE7DC; border:1px solid var(--color-clay); border-radius: 5px;
    font-family:var(--font-display); font-style:italic; color:var(--color-ink); font-size:15px;
  }

  .harbor-auth__form { display:flex; flex-direction:column; gap:16px; }
  .harbor-auth__field { display:flex; flex-direction:column; gap:6px; }
  .harbor-auth__label {
    font-family:var(--font-display); font-style:italic; font-size:15px; color:var(--color-clay);
  }
  .harbor-auth__form input {
    font-family:var(--font-body); font-size:15px; color:var(--color-ink);
    padding:10px 13px; border:1px solid var(--color-rule);
    background:var(--color-vellum);
    border-radius: 5px; outline:none;
    transition:border-color .15s ease;
  }
  .harbor-auth__form input:focus { border-color:var(--color-ink); }
  .harbor-auth__hint {
    font-family:var(--font-display); font-style:italic; font-size:13px; color:var(--color-ink-faded);
  }
  .harbor-auth__terms {
    font-family:var(--font-display); font-style:italic; font-size:13px; color:var(--color-ink-faded); line-height:1.55; margin:4px 0 0;
  }
  .harbor-auth__terms a { color:var(--color-ink-soft); }
  .harbor-auth__submit { margin-top:4px; align-self:flex-start; }
</style>
